    {
      "id": "de-beer-food",
      "order": 1,
      "title": "Ordering a beer/food like a local (Germany)",
      "icon": "🍺",
      "type": "dialogue",
      "description": "Q → A → what they'll probably say",
      "subsections": [
        {
          "id": "de-beer-food-main",
          "title": null,
          "exchanges": [
            {
              "id": "de-beer-food-01",
              "speaker": "them",
              "situation": { "en": "You're at a German bar and they ask what you'd like to drink." },
              "question": { "es": "Was möchten Sie trinken?", "en": "What would you like to drink?" },
              "answers": [
                { "es": "Ein Bier, bitte.", "en": "A beer, please." },
                { "es": "Ein Helles, bitte.", "en": "A pale lager, please — common in the south." }
              ],
              "likelyReply": { "es": "Vom Fass oder aus der Flasche?", "en": "Draft or bottle?" },
              "notes": "\"Ein Helles\" is the southern default. Servers open with the formal Sie.",
              "difficulty": "easy",
              "quizQuestions": []
            },
            {
              "id": "de-beer-food-02",
              "speaker": "them",
              "situation": { "en": "You've ordered a beer and they ask how you want it." },
              "question": { "es": "Vom Fass oder aus der Flasche?", "en": "Draft or bottle?" },
              "answers": [
                { "es": "Vom Fass, bitte.", "en": "Draft, please." },
                { "es": "Aus der Flasche, bitte.", "en": "Bottle, please." }
              ],
              "likelyReply": { "es": "Welche Marke?", "en": "Which brand?" },
              "notes": "",
              "difficulty": "easy",
              "quizQuestions": []
            },
            {
              "id": "de-beer-food-03",
              "speaker": "them",
              "situation": { "en": "They ask whether you want something to eat as well." },
              "question": { "es": "Möchten Sie auch was zu essen?", "en": "Want food too?" },
              "answers": [
                { "es": "Nur was Kleines.", "en": "Just something small." },
                { "es": "Vielleicht Pommes.", "en": "Maybe fries." }
              ],
              "likelyReply": { "es": "Kommt sofort.", "en": "Coming right up." },
              "notes": "",
              "difficulty": "easy",
              "quizQuestions": []
            },
            {
              "id": "de-beer-food-04",
              "speaker": "them",
              "situation": { "en": "You're paying as a group and they ask how." },
              "question": { "es": "Zahlen Sie zusammen oder getrennt?", "en": "Together or split?" },
              "answers": [
                { "es": "Zusammen.", "en": "Together." },
                { "es": "Getrennt, bitte.", "en": "Separately, please." }
              ],
              "likelyReply": { "es": "Mit Karte oder bar?", "en": "Card or cash?" },
              "notes": "Splitting the bill is completely normal and expected.",
              "difficulty": "easy",
              "quizQuestions": []
            }
          ]
        },
        {
          "id": "de-beer-food-bayern",
          "title": "Bayern add-on (if you're in Munich / Bavaria)",
          "type": "tips",
          "items": [
            { "es": "Einen Maß, bitte.", "en": "A 1-litre beer — very Bavaria." },
            { "es": "Servus!", "en": "Hello/bye, informal." }
          ]
        }
      ]
    },
