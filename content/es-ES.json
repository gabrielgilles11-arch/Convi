    {
      "id": "starting-convo",
      "order": 2,
      "title": "Starting a convo/basic survival",
      "icon": "💬",
      "type": "dialogue",
      "description": "Q → A → what they'll probably say",
      "subsections": [
        {
          "id": "starting-convo-main",
          "title": null,
          "exchanges": [
            {
              "id": "starting-convo-01",
              "question": { "es": "¡Perdona! / ¡Oye!", "en": "Excuse me! / Hey!" },
              "answers": [],
              "likelyReply": { "es": "Dime. / ¿Sí?", "en": "Tell me. / Yes?" },
              "notes": "Used to get someone's attention.",
              "difficulty": "easy",
              "quizQuestions": []
            },
            {
              "id": "starting-convo-02",
              "question": { "es": "¿De dónde eres?", "en": "Where are you from?" },
              "answers": [
                { "es": "Yo soy de los Estados Unidos.", "en": "I am from the US." }
              ],
              "likelyReply": { "es": "¿Y tú?", "en": "And you?" },
              "notes": "\"Y tú?\" is your natural follow-up here, not their reply.",
              "difficulty": "easy",
              "quizQuestions": []
            },
            {
              "id": "starting-convo-03",
              "question": { "es": "¿Hablas inglés?", "en": "Do you speak English?" },
              "answers": [
                { "es": "Un poco.", "en": "A little." },
                { "es": "No, lo siento.", "en": "No, sorry." }
              ],
              "likelyReply": { "es": "Pero te entiendo.", "en": "But I understand you." },
              "notes": "This exchange flips — the local answers this one.",
              "difficulty": "easy",
              "quizQuestions": []
            },
            {
              "id": "starting-convo-04",
              "question": { "es": "¿Cuánto tiempo llevas aquí?", "en": "How long have you been here?" },
              "answers": [
                { "es": "Llevo __ días/semanas.", "en": "I've been here __ days/weeks." },
                { "es": "Acabo de llegar.", "en": "I just arrived." }
              ],
              "likelyReply": { "es": "¿Y qué te parece?", "en": "What do you think of it?" },
              "notes": "",
              "difficulty": "medium",
              "quizQuestions": []
            },
            {
              "id": "starting-convo-05",
              "question": { "es": "Cuando no entiendes lo que dijeron", "en": "When someone says something you don't understand" },
              "answers": [
                { "es": "Perdona. No entiendo.", "en": "Sorry, I don't understand." }
              ],
              "likelyReply": null,
              "notes": "",
              "difficulty": "easy",
              "quizQuestions": []
            },
            {
              "id": "starting-convo-06",
              "question": { "es": "¿Cómo se dice __ en español?", "en": "How do you say __ in Spanish?" },
              "answers": [
                { "es": "Se dice __.", "en": "It's said __." }
              ],
              "likelyReply": { "es": "¿Lo pillas? / ¿Lo entiendes?", "en": "Got it?" },
              "notes": "The local answers first here with \"Se dice __\", then checks your understanding.",
              "difficulty": "medium",
              "quizQuestions": []
            },
            {
              "id": "starting-convo-07",
              "question": { "es": "Hasta luego.", "en": "See you later!" },
              "answers": [],
              "likelyReply": null,
              "notes": "Closing line to end the conversation.",
              "difficulty": "easy",
              "quizQuestions": []
            }
          ]
        }
