      "subsections": [
        {
          "id": "beer-food-main",
          "title": null,
          "exchanges": [
            {
              "id": "beer-food-01",
              "question": { "es": "¿Qué vas a tomar?/¿Que quieres beber?", "en": "What are you having?" },
              "answers": [
                { "es": "Una caña/una jarra/un doble, porfa.", "en": "A small/pint-size beer, please." },
                { "es": "Una cerveza, por favor.", "en": "A beer, please." }
              ],
              "likelyReply": { "es": "Vale. ¿Algo de comer? / ¿Y para picar?", "en": "Okay. Something to eat? / Anything to snack on?" },
              "notes": "",
              "difficulty": "easy",
              "quizQuestions": []
            },
            {
              "id": "beer-food-02",
              "question": { "es": "¿De barril o de botella?", "en": "Draft or bottle?" },
              "answers": [
                { "es": "De barril, gracias.", "en": "Draft, thanks." },
                { "es": "De botella, gracias.", "en": "Bottle, thanks." }
              ],
              "likelyReply": { "es": "¿Cuál? Tenemos Mahou/Estrella…", "en": "Which one? We have Mahou/Estrella…" },
              "notes": "",
              "difficulty": "easy",
              "quizQuestions": []
            },
            {
              "id": "beer-food-03",
              "question": { "es": "¿Rubia o tostada?", "en": "Blonde (lager) or amber?" },
              "answers": [
                { "es": "Rubia.", "en": "Blonde/lager." },
                { "es": "Tostada.", "en": "Amber." }
              ],
              "likelyReply": { "es": "Vale. Ahora te la pongo.", "en": "Alright. I'll get it now." },
              "notes": "",
              "difficulty": "easy",
              "quizQuestions": []
            },
            {
              "id": "beer-food-04",
              "question": { "es": "¿Algo más?", "en": "Anything else?" },
              "answers": [
                { "es": "Nada más, gracias.", "en": "Nothing else, thanks." },
                { "es": "Sí: una tapa de tortilla, porfa.", "en": "Yes: a tortilla tapa, please." }
              ],
              "likelyReply": { "es": "Perfecto.", "en": "Perfect." },
              "notes": "",
              "difficulty": "easy",
              "quizQuestions": []
            },
            {
              "id": "beer-food-05",
              "question": { "es": "¿Para aquí o para llevar?", "en": "For here or to go?" },
              "answers": [
                { "es": "Para aquí.", "en": "For here." },
                { "es": "Para llevar.", "en": "To go." }
              ],
              "likelyReply": { "es": "Son __ euros.", "en": "That'll be __ euros." },
              "notes": "",
              "difficulty": "easy",
              "quizQuestions": []
            },
            {
              "id": "beer-food-06",
              "question": { "es": "¿Te pongo otra?", "en": "Want another one?" },
              "answers": [
                { "es": "Sí, una más.", "en": "Yes, one more." },
                { "es": "No, gracias.", "en": "No, thanks." }
              ],
              "likelyReply": { "es": "Vale.", "en": "Okay." },
              "notes": "",
              "difficulty": "easy",
              "quizQuestions": []
            },
            {
              "id": "beer-food-07",
              "question": { "es": "¿Cómo quieres pagar?", "en": "How do you want to pay?" },
              "answers": [
                { "es": "Con tarjeta.", "en": "By card." },
                { "es": "En efectivo.", "en": "In cash." }
              ],
              "likelyReply": { "es": "Acércala aquí.", "en": "Tap it here." },
              "notes": "",
              "difficulty": "medium",
              "quizQuestions": []
            },
            {
              "id": "beer-food-08",
              "question": { "es": "¿La cuenta? / ¿Queréis la cuenta?", "en": "The check? / Do you want the check?" },
              "answers": [
                { "es": "La cuenta, porfa.", "en": "The check, please." }
              ],
              "likelyReply": { "es": "Ahora mismo.", "en": "Right away." },
              "notes": "",
              "difficulty": "easy",
              "quizQuestions": []
            }
          ]
        },
        {
          "id": "beer-food-tips",
          "title": "Tiny upgrades that sound natural (Spain)",
          "type": "tips",
