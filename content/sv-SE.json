              "id": "sv-beer-food-01",
              "question": {
                "es": "Vad får det lov att vara?",
                "en": "What can I get you?"
              },
              "answers": [
                {
                  "es": "En öl, tack.",
                  "en": "A beer, please."
                },
                {
                  "es": "En stor stark, tack.",
                  "en": "A \"standard\" lager, please."
                }
              ],
              "likelyReply": {
                "es": "På fat eller flaska?",
                "en": "Draft or bottle?"
