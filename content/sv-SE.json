                {
                  "es": "På fat, tack.",
                  "en": "Draft, please."
                },
                {
                  "es": "Flaska funkar.",
                  "en": "Bottle's fine."
                }
              ],
              "likelyReply": {
                "es": "Vilken vill du ha? / Nån särskild?",
