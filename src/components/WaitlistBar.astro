---
/**
 * "The app isn't out yet": a floating bar that collects early-access emails.
 *
 * The signup form at the foot of the home page is the only other place that
 * asks, and most visitors never scroll that far. This one comes up from the
 * bottom of every reading page after a few seconds or a little scrolling, and
 * goes away for good once you join, or for two weeks once you close it.
 *
 * It never renders on Practice: a round has its own answer drawer at the
 * bottom of the screen, and a bar over it is a bar over the answer. It steps
 * aside while the home page's own signup section is on screen, so the page
 * never asks twice at once.
 *
 * Without JavaScript it stays hidden (it cannot post the form anyway) and the
 * home page's signup section is still there.
 */
---

<aside class="waitlist" id="waitlist" aria-label="Early access to the app" hidden>
  <div class="waitlist-card">
    <span class="waitlist-icon" aria-hidden="true">¡!</span>
    <div class="waitlist-copy">
      <span class="waitlist-badge">Coming soon</span>
      <p class="waitlist-title">The app isn't out yet.</p>
      <p class="waitlist-sub">Get early access, and the printable phrasebook when it's ready.</p>
    </div>

    <form class="waitlist-form" id="waitlist-form" novalidate>
      <label class="waitlist-label" for="waitlist-email">Email address</label>
      <input
        id="waitlist-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        placeholder="you@email.com"
        required
      />
      <button type="submit" class="waitlist-submit">Get early access</button>
    </form>

    <p class="waitlist-done" role="status" hidden>You're on the list. We'll email you when it's ready.</p>
    <p class="waitlist-error" role="alert" hidden></p>

    <button type="button" class="waitlist-close" aria-label="Close">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</aside>

<script>
  const KEY = "convi:waitlist-bar:v1";
  /** Closed, it stays away this long. Joined, it stays away for good. */
  const SNOOZE_MS = 14 * 24 * 60 * 60 * 1000;
  /** Up after this long on the page, or this much scrolling, whichever first. */
  const AFTER_MS = 6000;
  const AFTER_SCROLL = 0.4; // of the viewport height

  const bar = document.getElementById("waitlist");
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function remembered(): string | null {
    try {
      return window.localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }

  function remember(value: string): void {
    try {
      window.localStorage.setItem(KEY, value);
    } catch {
      // No storage: it may come back next visit, which is the lesser harm.
    }
  }

  function suppressed(): boolean {
    const value = remembered();
    if (!value) return false;
    if (value === "joined") return true;
    const at = Number(value.split(":")[1]);
    return Number.isFinite(at) && Date.now() - at < SNOOZE_MS;
  }

  if (bar && !suppressed()) {
    const form = bar.querySelector<HTMLFormElement>(".waitlist-form")!;
    const input = bar.querySelector<HTMLInputElement>("#waitlist-email")!;
    const submit = bar.querySelector<HTMLButtonElement>(".waitlist-submit")!;
    const close = bar.querySelector<HTMLButtonElement>(".waitlist-close")!;
    const done = bar.querySelector<HTMLElement>(".waitlist-done")!;
    const error = bar.querySelector<HTMLElement>(".waitlist-error")!;

    let shown = false;
    let blocked = false; // the page's own signup section is on screen
    let finished = false;

    // Room at the bottom of the page while the bar is up, so it never sits
    // over the footer's last line with no way to scroll past it.
    const pad = () => {
      const up = shown && !blocked && !finished;
      document.documentElement.style.setProperty("--waitlist-space", up ? `${bar.offsetHeight + 24}px` : "0px");
    };
    const render = () => {
      bar.classList.toggle("is-up", shown && !blocked);
      bar.setAttribute("aria-hidden", shown && !blocked ? "false" : "true");
      bar.inert = !(shown && !blocked);
      pad();
    };

    function show() {
      if (shown) return;
      shown = true;
      bar!.hidden = false;
      // One frame in the hidden-below position, so the slide has a start.
      requestAnimationFrame(() => requestAnimationFrame(render));
      window.removeEventListener("scroll", onScroll);
      window.clearTimeout(timer);
    }

    function hide(after?: () => void) {
      finished = true;
      bar!.classList.remove("is-up");
      pad();
      window.setTimeout(() => {
        bar!.hidden = true;
        after?.();
      }, 450);
    }

    const onScroll = () => {
      if (window.scrollY > window.innerHeight * AFTER_SCROLL) show();
    };
    const timer = window.setTimeout(show, AFTER_MS);
    window.addEventListener("scroll", onScroll, { passive: true });

    // Step aside while the page asks the same thing itself.
    const own = document.querySelector("[data-waitlist-own]");
    if (own && "IntersectionObserver" in window) {
      new IntersectionObserver((entries) => {
        blocked = entries.some((e) => e.isIntersecting);
        if (shown && !finished) render();
      }, { threshold: 0.2 }).observe(own);
    }

    window.addEventListener("resize", pad, { passive: true });


    close.addEventListener("click", () => {
      remember(`dismissed:${Date.now()}`);
      hide();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && shown && !finished && bar.contains(document.activeElement)) {
        remember(`dismissed:${Date.now()}`);
        hide();
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      error.hidden = true;
      const email = input.value.trim();
      if (!EMAIL_RE.test(email)) {
        error.textContent = "That email doesn't look right.";
        error.hidden = false;
        input.focus();
        return;
      }
      submit.disabled = true;
      submit.textContent = "Joining…";
      try {
        const res = await fetch("/api/signup", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        if (!res.ok) throw new Error(String(res.status));
        remember("joined");
        bar.classList.add("is-done");
        form.hidden = true;
        done.hidden = false;
        pad();
        window.setTimeout(() => hide(), 3200);
      } catch {
        error.textContent = "Something went wrong. Try again in a moment.";
        error.hidden = false;
        submit.disabled = false;
        submit.textContent = "Get early access";
      }
    });
  }
</script>

<style>
  /*
   * Frosted glass over the page: the page shows through, blurred, so the bar
   * reads as floating above the content rather than covering it. The glass is
   * opaque enough (0.72 over warm white) that the ink text keeps AA contrast
   * whatever passes behind it, the orange phrase band included.
   */
  .waitlist {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    padding: 0 var(--shell-pad) max(1.1rem, env(safe-area-inset-bottom));
    pointer-events: none;
    transform: translateY(calc(100% + 1rem));
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.35s ease;
  }

  .waitlist.is-up {
    transform: none;
    opacity: 1;
  }

  .waitlist-card {
    position: relative;
    pointer-events: auto;
    max-width: var(--shell-text);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.85rem 0.85rem 0.85rem 1rem;
    border-radius: 22px;
    color: var(--color-ink);
    background: rgba(255, 248, 242, 0.72);
    -webkit-backdrop-filter: blur(22px) saturate(170%);
    backdrop-filter: blur(22px) saturate(170%);
    border: 1px solid rgba(255, 255, 255, 0.75);
    box-shadow:
      0 24px 60px rgba(36, 22, 16, 0.18),
      0 2px 8px rgba(36, 22, 16, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  /* No blur available: the glass turns solid rather than see-through, so the
     text never sits on unblurred content. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .waitlist-card {
      background: rgba(255, 248, 242, 0.97);
    }
  }

  .waitlist-icon {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 15px;
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, #e0612a, #b8410f);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 4px 10px rgba(184, 65, 15, 0.25);
  }

  .waitlist-copy {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .waitlist-badge {
    align-self: flex-start;
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    background: rgba(203, 74, 22, 0.12);
    color: #993b18;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .waitlist-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .waitlist-sub {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-ink-soft);
  }

  .waitlist-form {
    flex: none;
    min-width: 0;
    display: flex;
    gap: 0.5rem;
  }

  .waitlist-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .waitlist-form input {
    width: 13.5rem;
    min-width: 0;
    height: 46px;
    box-sizing: border-box;
    padding: 0 0.9rem;
    border-radius: 12px;
    border: 1px solid rgba(36, 22, 16, 0.14);
    background: rgba(255, 255, 255, 0.78);
    color: var(--color-ink);
    font: inherit;
    font-size: 0.95rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .waitlist-form input::placeholder {
    color: #8a7566;
  }

  .waitlist-form input:focus {
    outline: none;
    background: #fff;
    border-color: #cb4a16;
    box-shadow: 0 0 0 3px rgba(203, 74, 22, 0.18);
  }

  .waitlist-submit {
    height: 46px;
    padding: 0 1.15rem;
    border: 0;
    border-radius: 12px;
    background: #cb4a16;
    color: #fff;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 800;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 3px 0 #993b18;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .waitlist-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 0 #993b18;
  }

  .waitlist-submit:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #993b18;
  }

  .waitlist-submit:disabled {
    opacity: 0.75;
    cursor: progress;
  }

  .waitlist-submit:focus-visible,
  .waitlist-close:focus-visible {
    outline: 3px solid #cb4a16;
    outline-offset: 2px;
  }

  .waitlist-done {
    margin: 0;
    flex: none;
    padding-right: 0.5rem;
    font-weight: 800;
    color: #993b18;
  }

  .waitlist-error {
    position: absolute;
    left: 1rem;
    bottom: calc(100% + 0.5rem);
    margin: 0;
    padding: 0.3rem 0.7rem;
    border-radius: 10px;
    background: var(--color-ink);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .waitlist-close {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .waitlist-close:hover {
    background: rgba(36, 22, 16, 0.07);
    color: var(--color-ink);
  }

  .waitlist-close svg {
    width: 16px;
    height: 16px;
  }

  /* Below a laptop: words and close on one row, the form under them. */
  @media (max-width: 760px) {
    .waitlist-card {
      flex-wrap: wrap;
      gap: 0.6rem 0.75rem;
      padding: 0.7rem 0.6rem 0.75rem 0.75rem;
      border-radius: 20px;
    }

    .waitlist-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      font-size: 1.25rem;
    }

    .waitlist-copy {
      flex: 1 1 0;
    }

    .waitlist-close {
      order: 2;
    }

    .waitlist-form,
    .waitlist-done {
      order: 3;
      flex: 1 1 100%;
    }

    .waitlist-form input {
      flex: 1 1 auto;
      width: auto;
    }
  }

  /* A phone: the title alone beside the icon. */
  @media (max-width: 560px) {
    .waitlist-badge,
    .waitlist-sub {
      display: none;
    }

    .waitlist-title {
      font-size: 1.06rem;
    }

    .waitlist-submit {
      padding: 0 0.9rem;
    }
  }

  /* The narrowest phones: the field and the button each take the full width. */
  @media (max-width: 380px) {
    .waitlist-form {
      flex-wrap: wrap;
    }

    .waitlist-form input,
    .waitlist-submit {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .waitlist {
      transform: none;
      transition: opacity 0.2s linear;
    }

    .waitlist-submit,
    .waitlist-close,
    .waitlist-form input {
      transition: none;
    }
  }

  /* While the bar is up, the page gets room under it. */
  :global(body) {
    padding-bottom: var(--waitlist-space, 0px);
    transition: padding-bottom 0.3s ease;
  }
</style>
