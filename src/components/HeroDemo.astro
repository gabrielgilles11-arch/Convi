---
import { getHeroDemo } from "../lib/heroDemo";

/**
 * The product, above the fold.
 *
 * A Talk Mode exchange from the Spanish edition, playing on a loop: the
 * bartender opens, you produce a line, they come back at you. It replaced a
 * paper-plane SVG, which held the most valuable space on the site and said
 * nothing, while the thing the site is for sat two clicks away.
 *
 * Three rules it is built to, because a looping animation in a hero is the
 * easiest place on a site to put a bug nobody reports:
 *
 * 1. **It is complete before any script runs.** Every line is in the markup,
 *    visible, in order. No JavaScript, a blocked bundle, a crawler or a reader
 *    gets the whole conversation as static text. The script only takes over
 *    the pacing.
 * 2. **It never moves the page.** Bubbles are revealed with opacity, never by
 *    being inserted or by `display`, so the card reserves the height of the
 *    whole conversation from the first frame and is exactly as tall on the
 *    last. Nothing below it shifts, including the fold. The cost of showing
 *    the whole exchange this way is that the card is only part filled early in
 *    each loop; the trade was made deliberately, for a card that ends up
 *    holding all six lines at once.
 * 3. **It stops when nobody is watching.** Off screen, in a hidden tab, or
 *    under `prefers-reduced-motion`, the timer is cleared rather than left
 *    running against a card nobody can see.
 *
 * The lines come from `content/es-ES.json` through ../lib/heroDemo at build
 * time, so this file holds no Spanish of its own to go stale.
 */
const demo = getHeroDemo();

/**
 * Steps, and how long each holds before the next.
 *
 * A beat is three steps: their line (with the situation above it), yours, then
 * their comeback. Yours follows theirs quickly, because reading a question and
 * answering it is one thought; their comeback lands a beat later; and the gap
 * before the next beat opens is the longest of the three, since that is where
 * one moment ends and another starts.
 *
 * Six steps at these delays plus the hold is a little over ten seconds, which
 * is about as long as anybody looks at a hero before scrolling.
 */
const STEP_MS = { them: 1500, you: 1300, reply: 1800 };
const HOLD_MS = 2600;

const delays = demo.beats.flatMap(() => [STEP_MS.them, STEP_MS.you, STEP_MS.reply]);
const lastStep = delays.length - 1;
---

<div class="demo" data-demo>
  <p class="demo-top">
    <span class="demo-flag" aria-hidden="true">{demo.flag}</span>
    <span class="demo-mode">Talk Mode</span>
    <span class="demo-where">{demo.language}, at the bar</span>
  </p>

  <ol class="demo-feed">
    {
      demo.beats.map((beat, i) => (
        <li class="demo-beat">
          <p class="demo-situation demo-step" data-step={i * 3}>
            {beat.situation}
          </p>
          <p class="demo-bubble demo-bubble--them demo-step" data-step={i * 3}>
            <span class="demo-source">{beat.them.source}</span>
            <span class="demo-en">{beat.them.en}</span>
          </p>
          <p class="demo-bubble demo-bubble--you demo-step" data-step={i * 3 + 1}>
            <span class="demo-source">{beat.you.source}</span>
            <span class="demo-en">{beat.you.en}</span>
            {beat.you.note && <span class="demo-note">{beat.you.note}</span>}
          </p>
          <p class="demo-bubble demo-bubble--them demo-step" data-step={i * 3 + 2}>
            <span class="demo-source">{beat.reply.source}</span>
            <span class="demo-en">{beat.reply.en}</span>
          </p>
        </li>
      ))
    }
  </ol>

  <p class="demo-foot">You type the line. They answer back.</p>
</div>

{/* Inline and immediately after the card on purpose, for the same reason the
    language button's script is: the card ships fully visible, and this is what
    hides it to start the loop. Left to a bundled module it would run after
    first paint, so the whole conversation would be seen at once and then blink
    out. */}
<script is:inline define:vars={{ delays, lastStep, HOLD_MS }}>
  (() => {
    const root = document.querySelector("[data-demo]");
    if (!root) return;

    const steps = Array.from(root.querySelectorAll("[data-step]"));
    if (steps.length === 0 || lastStep < 0) return;

    // How long the finished conversation sits blank before it starts over, and
    // how long after coming back on screen the next line lands. Neither is the
    // first frame of anything, so both are short.
    const BLANK_MS = 420;
    const RESUME_MS = 600;

    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");

    /** Frame to render next: 0..lastStep are steps, lastStep + 1 blanks it. */
    let cursor = 0;
    let timer = null;
    let running = false;
    let started = false;
    let onScreen = false;

    /**
     * The conversation as far as `upTo`. `-1` is an empty card.
     *
     * Cumulative, across both beats: a line arrives and stays, so the card
     * fills from the top and ends the loop holding the whole exchange. That is
     * what makes it tall. Both beats are in the flow the whole time, so the
     * card reserves its full height from the first frame and nothing below it
     * ever moves; what changes is only how much of that height is filled.
     */
    const show = (upTo) => {
      for (const el of steps) {
        el.classList.toggle("is-in", Number(el.dataset.step) <= upTo);
      }
    };

    const stop = () => {
      running = false;
      if (timer !== null) {
        window.clearTimeout(timer);
        timer = null;
      }
    };

    const render = () => {
      timer = null;
      let wait;

      if (cursor > lastStep) {
        show(-1);
        cursor = 0;
        wait = BLANK_MS;
      } else {
        show(cursor);
        wait = cursor === lastStep ? HOLD_MS : delays[cursor] || 1500;
        cursor += 1;
      }

      if (running) timer = window.setTimeout(render, wait);
    };

    const start = () => {
      if (running || motion.matches || !onScreen || document.hidden) return;
      running = true;
      // First run starts at once; coming back to it picks up where it paused.
      timer = window.setTimeout(render, started ? RESUME_MS : 0);
      started = true;
    };

    /**
     * Static or animated, whichever the reader asked for.
     *
     * `demo-ready` is the class that hides the steps, so not adding it is what
     * leaves the card exactly as it was served: the full conversation, no
     * motion. Reduced motion can be turned on and off while the page is open,
     * so this runs on the change too rather than only at load.
     */
    const apply = () => {
      if (motion.matches) {
        stop();
        root.classList.remove("demo-ready");
        show(lastStep);
        started = false;
        cursor = 0;
      } else {
        root.classList.add("demo-ready");
        show(started ? cursor - 1 : -1);
        start();
      }
    };

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            onScreen = entry.isIntersecting;
            if (onScreen) start();
            else stop();
          }
        },
        { threshold: 0.2 }
      ).observe(root);
    } else {
      // No observer: the hero is on screen at load, which is the only time it
      // matters. Pacing it unconditionally beats leaving it frozen.
      onScreen = true;
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });

    if (typeof motion.addEventListener === "function") {
      motion.addEventListener("change", apply);
    }

    apply();
  })();
</script>

<style>
  .demo {
    width: 100%;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    box-shadow: 0 10px 30px rgba(36, 22, 16, 0.08);
    padding: 1.15rem 1.25rem 1.25rem;
    text-align: left;
  }

  .demo-top {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.75rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--color-border);
  }

  .demo-flag {
    font-size: 1.1rem;
    line-height: 1;
  }

  /* 12px is the floor, and only for an uppercase tracked label like this one. */
  .demo-mode {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-primary-dark);
  }

  .demo-where {
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
    margin-left: auto;
  }

  .demo-feed {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .demo-beat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .demo-situation {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--color-ink-soft);
    font-style: italic;
  }

  .demo-bubble {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    max-width: 88%;
    padding: 0.65rem 0.9rem;
    border-radius: 14px;
    border: 1px solid var(--color-border);
  }

  .demo-bubble--them {
    align-self: flex-start;
    background: var(--color-bg);
    border-bottom-left-radius: 5px;
  }

  /* Shaped like the box you type into, because in Talk Mode it is: this line
     is the one the learner produces, not one they are shown. */
  .demo-bubble--you {
    align-self: flex-end;
    background: var(--color-primary-tint);
    border-color: var(--color-primary-tint-border);
    border-bottom-right-radius: 5px;
  }

  .demo-source {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .demo-en {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--color-ink-soft);
  }

  .demo-note {
    font-size: 0.8125rem;
    line-height: 1.35;
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .demo-foot {
    margin: 0.9rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
  }

  /* Everything below is only once the script opts in. Without it the card
     stays as served: every beat listed down the page, every line visible. That
     is the no-JS and reduced-motion rendering, and it has to be a list rather
     than a stack or the beats would sit on top of each other. */
  .demo-ready .demo-step {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .demo-ready .demo-step.is-in {
    opacity: 1;
    transform: none;
  }

  /* Belt to the script's braces. If anything ever stops the media query being
     read in JavaScript, the card is still the whole conversation, visible and
     still. */
  @media (prefers-reduced-motion: reduce) {
    .demo-ready .demo-step {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
