---
import Logo from "../components/Logo.astro";
import LangMenu from "../components/LangMenu.astro";
import { localePath, localeFromSlug, getLocaleInfo, DEFAULT_LOCALE, type Locale } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  /** Drives the per-edition accent colour via [data-locale] below. */
  locale?: string;
  /**
   * Page-specific schema.org objects, joined to the site-wide ones in a single
   * @graph. Answer engines read this to work out what a page is actually about
   * without inferring it from the prose.
   */
  schema?: Record<string, unknown>[];
}

const {
  title = "Try Convi",
  description = "Learn how to speak like a local: real conversations, not textbook language.",
  locale,
  schema = [],
} = Astro.props;

// Header links stay inside the edition you're reading, so switching pages
// doesn't silently drop you back into Spanish.
const navLocale: Locale =
  (locale as Locale | undefined) ??
  localeFromSlug(Astro.url.pathname.split("/")[1]) ??
  DEFAULT_LOCALE;
const navPath = (path: string) => localePath(navLocale, path);

// Only edition pages pass `locale`, and only they should tick a language in the
// menus. The home and legal pages sit outside any edition, so nothing is ticked
// there even though their nav links resolve to the default edition.
const navCurrent = locale as Locale | undefined;

// The edition this page belongs to, as a URL slug, for the browser to remember.
// Spanish's slug is the empty string, so the attribute is rendered empty rather
// than omitted — present-and-empty is "Spanish", absent is "no edition here".
const localeSlug = navCurrent ? getLocaleInfo(navCurrent).slug : undefined;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);

// One @graph rather than several script tags: the site-level facts, then
// whatever the page adds about itself.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site?.href}#website`,
      name: "Try Convi",
      url: Astro.site?.href,
      description:
        "Learn how to speak like a local: real conversations, not textbook language.",
      inLanguage: "en",
      publisher: {
        "@type": "Organization",
        "@id": `${Astro.site?.href}#org`,
        name: "Try Convi",
        url: Astro.site?.href,
        logo: ogImage.href,
      },
    },
    ...schema,
  ],
};
---

<html lang="en" data-locale={locale} data-locale-slug={localeSlug}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Try Convi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand-link" href="/">
          <Logo />
        </a>
        <nav aria-label="Main">
          <LangMenu path="/scenarios" label="Scenarios" current={navCurrent} />
          <LangMenu path="/practice" label="Practice" current={navCurrent} />
        </nav>
        <a class="nav-cta" href={navPath("/scenarios")}>Get started</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <Logo />
          <p class="footer-tagline">Real conversations, not textbook language.</p>
        </div>
        <div class="footer-col">
          <h3>About</h3>
          <p>¡Try Convi! is a language platform that will teach you to speak like a local, built from real conversations you'll have in Spanish, Swedish and German.</p>
          {/* The About page carries the full section index, so this link is
              also what puts all 44 scenario pages one click from every page on
              the site rather than three. */}
          <p><a href="/about">What Try Convi is, and every section</a></p>
        </div>
        <div class="footer-col">
          <h3>Contact</h3>
          <p><a href="mailto:hello@tryconvi.com">hello@tryconvi.com</a></p>
          <div class="footer-social">
            <a href="https://www.youtube.com/@TryConvi" target="_blank" rel="noopener">YouTube</a>
            <a href="https://www.tiktok.com/@tryconvi" target="_blank" rel="noopener">TikTok</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} ¡Try Convi!</p>
        <nav class="footer-legal">
          <a href="/about">About</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </nav>
      </div>
    </footer>

    {/* One anonymous tick per page, from every page on the site. It carries
        nothing: which country and whether this browser has been here before
        are worked out from the request itself, and the address is hashed
        before anything is written. See src/lib/stats.ts. */}
    <script>
      import { recordView } from "../lib/usage";
      import { rememberLocaleSlug } from "../lib/lastLocale";
      import { reminderHeartbeat } from "../lib/reminderClient";
      import { currentDayStreak } from "../lib/progress";
      recordView();

      // Remember which edition this was, so the home page's one button can open
      // it again next time. Read off the document rather than passed in: this
      // script is bundled once for every page, so it cannot be templated.
      // `undefined` means a page outside any edition (home, privacy, terms) —
      // those must not overwrite a real choice, and "" is Spanish, not nothing.
      const slug = document.documentElement.dataset.localeSlug;
      if (slug !== undefined) rememberLocaleSlug(slug);

      // "They are here", for anybody who asked to be reminded — a no-op for
      // everyone else, which is almost everyone. It runs from every page and not
      // only from practice, because not finishing a round is not the same thing
      // as not turning up, and it is what makes "they stopped using the site"
      // something the sender can actually check rather than assume. Separate
      // from the view beacon above on purpose: that one carries nothing, and
      // attaching a subscriber id to it would turn site counters into
      // per-person analytics.
      reminderHeartbeat({
        locale: document.documentElement.dataset.locale,
        streak: currentDayStreak(),
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;

    /* Duolingo's system: the display face is also the logo face, paired with a
       rounded sans for everything else. Wordmark stays its own variable so the
       logo can never be changed by a heading decision. */
    --font-wordmark: "Fredoka", system-ui, sans-serif;
    --font-display: "Fredoka", system-ui, sans-serif;
    --font-body: "Nunito", system-ui, -apple-system, "Segoe UI", sans-serif;

    /*
     * How wide the page is allowed to get.
     *
     * Three tokens rather than a pixel number repeated in nine places, because
     * the old numbers disagreed with each other: the header sat at 960, `main`
     * at 720 and the marketing bands at 960, so on a 16-inch laptop the site
     * was a 960px column with 384px of empty page either side of it and the
     * text inside it narrower still. That reads as compressed, which is what
     * it was.
     *
     * The caps are plain pixels and the gutter is a clamp, so the width is
     * continuous: below the cap a band is simply the window less its padding,
     * and it grows with the window at every size rather than jumping at two or
     * three breakpoints. The gutter does the same, from 16px on a phone to
     * 40px on a desktop. Putting a vw term in the caps as well was double
     * counting, and cost a 320px screen six pixels of the only thing on it.
     *
     * --shell-wide  bands that are mostly layout: the hero and the section
     *               grids.
     * --shell-text  anything that is a paragraph somebody reads top to bottom.
     *               Deliberately not --shell-wide: a line of prose 1,200px
     *               long is harder to read, not easier, and the fix for a
     *               cramped page is never a 130-character measure.
     * --shell-pad   the side gutter, never below the 16px the design pass set.
     *
     * The header and footer take neither cap. They are the frame rather than
     * the content: the wordmark belongs at the edge of the window, not 320px
     * into it behind a margin that exists to keep sentences readable. So they
     * run the full width and the gutter alone holds them off the edge, which
     * is the usual arrangement and the one that reads as a site rather than a
     * column. The bands below stay centred and capped, because that is what a
     * line of text needs and a navigation bar does not.
     */
    --shell-wide: 1600px;
    --shell-text: 800px;
    --shell-pad: clamp(1rem, 3vw, 3rem);

    --color-bg: #fff6ec;
    --color-ink: #241610;
    --color-ink-soft: #5f4c3e;
    /*
     * Two jobs, two values, and the difference between them is a contrast
     * requirement rather than a taste.
     *
     * `--color-primary` is a fill with white text on it: buttons, the lit tab,
     * a cleared stone. That makes it text-on-a-background, so it has to clear
     * 4.5:1 against white. The old orange managed 3.38, the old German gold
     * 2.70 — a primary button whose label was the least legible text on the
     * page.
     *
     * `--color-primary-dark` is the ink version: a link, a small label, the
     * drop shadow under a button. It is measured against the cream page
     * instead, and sits far enough below the fill that the shadow still reads
     * as a shadow.
     */
    --color-primary: #cb4a16;
    --color-primary-dark: #993b18;
    --color-primary-tint: #ffe6d5;
    --color-primary-tint-border: #f5c8a3;
    --color-accent: #f4a623;
    --color-card: #ffffff;
    --color-border: #f0dcc8;
    --color-success: #2e7d32;
    --color-success-deep: #17804a;
    --color-success-bg: #eaf6ec;
    --color-error: #c62828;
    --color-error-bg: #fbeaea;

    /* The page is a warm cream, which is easy on the eyes but goes flat over a
       full screen. Two soft washes give it depth; every edition tints them to
       its own accent so the background belongs to the language you're in. */
    --color-wash-1: #ffe3cd;
    --color-wash-2: #f1ecff;

    /* Answer-choice hues. Four fixed colours, one per slot, so the options read
       as four distinct things rather than four identical grey boxes.
       Deliberately no green and no red among them: those two stay reserved for
       right/wrong, so a colour never means two things at once.
       `-deep` is the variant that carries white text at 4.5:1 or better; the
       bare hue is for borders, badges and glows. */
    --opt-a: #f2683c;
    /* Darkened to 4.65:1 against its own tint: the path stones use deep-on-tint
       for a section not yet started, and this was the one hue of the four that
       did not clear 4.5 that way. */
    --opt-a-deep: #be451d;
    --opt-a-tint: #fff0e8;
    --opt-b: #6d5ce7;
    --opt-b-deep: #4f3fc4;
    --opt-b-tint: #f0edff;
    --opt-c: #12a3a3;
    --opt-c-deep: #0a7676;
    --opt-c-tint: #e4f7f7;
    --opt-d: #f0a91b;
    --opt-d-deep: #8f5e04;
    --opt-d-tint: #fff4d9;

    font-family: var(--font-body);
  }

  /* Per-edition accents. The Spanish orange stays the default (and the brand),
     so only the newer editions override it. Everything downstream reads these
     variables, so nothing else needs to know which language it's rendering. */
  [data-locale="sv-SE"] {
    --color-primary: #2f6fa8;
    --color-primary-dark: #24567f;
    --color-primary-tint: #dfeaf5;
    --color-primary-tint-border: #b3cbe2;
    --color-wash-1: #dceaf7;
    --color-wash-2: #e4f5f1;
  }

  /* The gold moved furthest, because it had furthest to go: white on the old
     one was 2.70:1, which is not a label so much as a suggestion of one. */
  [data-locale="de-DE"] {
    --color-primary: #946e20;
    --color-primary-dark: #735418;
    --color-primary-tint: #faeed2;
    --color-primary-tint-border: #e6cf9a;
    --color-wash-1: #fbedcd;
    --color-wash-2: #f6e6e0;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    color: var(--color-ink);
    /* Fixed so the washes stay put while you scroll a long scenario, instead
       of sliding past and drawing attention to themselves. */
    background: radial-gradient(70rem 38rem at 8% -8%, var(--color-wash-1), transparent 62%),
      radial-gradient(58rem 34rem at 102% 2%, var(--color-wash-2), transparent 58%),
      var(--color-bg);
    background-attachment: fixed;
    background-color: var(--color-bg);
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  main {
    max-width: var(--shell-text);
    margin: 0 auto;
    padding: clamp(1.5rem, 3vw, 2.75rem) var(--shell-pad) clamp(4rem, 6vw, 6rem);
  }

  /*
   * Focus mode: a round, a taster or a conversation.
   *
   * The header is a shop window and the footer is a site index. Both belong on
   * the way in; neither belongs above a question somebody is in the middle of
   * answering, and on a 390px phone they were costing enough room that the
   * first answer option sat below the fold. The island sets `data-focus` on
   * the body while it owns the screen, and the page keeps only what the round
   * itself needs: the way out, the progress bar and the counters.
   */
  body[data-focus="round"] .site-header,
  body[data-focus="round"] .site-footer,
  body[data-focus="round"] .page-head {
    display: none;
  }

  body[data-focus="round"] main {
    padding-top: 0.75rem;
  }

  .container {
    max-width: var(--shell-text);
    margin: 0 auto;
    padding: 0 var(--shell-pad);
  }

  /* Opt-in for a section that is layout rather than prose. A page says which
     of its bands are which; the default stays the readable one. */
  .container--wide {
    max-width: var(--shell-wide);
  }

  .full-bleed {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
  }

  .site-header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    max-width: none;
    padding: 0.9rem var(--shell-pad);
  }

  .site-header .brand-link {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .site-header nav {
    display: flex;
    gap: 1.25rem;
    margin-right: auto;
    margin-left: 1.5rem;
  }

  /* Direct children only — the nav also holds LangMenu dropdowns, and these
     rules are global, so a descendant selector would leak into their panels. */
  .site-header nav > a {
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.5rem 0;
  }

  .site-header nav > a:hover {
    color: var(--color-primary-dark);
  }

  .nav-cta {
    min-height: 44px;
    display: inline-block;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: var(--color-primary-dark);
  }

  .site-footer {
    background: #170f0a;
    color: #f3e9df;
  }

  .site-footer .footer-brand {
    --color-ink: #fff;
  }

  .site-footer .container {
    max-width: none;
    padding: clamp(2.75rem, 5vw, 4.5rem) var(--shell-pad) 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr);
    /* Tracks stop growing at the point a column stops reading as one; past
       that the window's extra width goes into the gap instead. */
    gap: clamp(2rem, 4vw, 5rem);
  }

  .footer-grid > * {
    max-width: 34rem;
  }

  .footer-tagline {
    color: #cbb9a8;
    font-size: 0.9rem;
    margin: 0.6rem 0 0;
  }

  .footer-col h3 {
    /* Small uppercase label — the serif would look wrong at this size. */
    font-family: var(--font-body);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    margin: 0 0 0.6rem;
  }

  .footer-col p {
    color: #cbb9a8;
    font-size: 0.9rem;
    margin: 0 0 0.5rem;
    line-height: 1.5;
  }

  .footer-col a {
    color: #f3e9df;
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--color-accent);
  }

  .footer-social {
    display: flex;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1rem 1.25rem;
    text-align: center;
    font-size: 0.8125rem;
    color: #8c796a;
  }

  .footer-legal {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  /* Standalone links, not links inside a sentence, so the tap target rule
     applies to them: 44px is the pad of a fingertip, and these sit close
     enough together to punish a near miss. */
  .footer-social a,
  .brand-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* Short words, so the height alone does not make the target: "About" is
     38px wide and a thumb is wider than that. */
  .footer-legal a {
    justify-content: center;
    min-width: 44px;
  }

  .footer-legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #8c796a;
    text-decoration: none;
  }

  .footer-legal a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .site-header nav {
      gap: 0.85rem;
      margin-left: 1rem;
    }
  }

  /* Brand, nav and CTA do not fit on one line at phone width, and
     space-between plus wrap put each of them on a line of its own: three rows,
     145px of a 390px screen, before any page had said anything. The brand takes
     the first row outright and the other two share the second. */
  @media (max-width: 560px) {
    .site-header .container {
      padding: 0.6rem var(--shell-pad);
      row-gap: 0.35rem;
    }

    .site-header .brand-link {
      flex: 1 0 100%;
    }

    .site-header nav {
      margin-left: 0;
      margin-right: auto;
      gap: 0.85rem;
    }

    /* The nav links are LangMenu <summary>s, not <a>s, so the 0.95rem rule
       above does not reach them and they were inheriting the 17px body size —
       which is the 40px that stopped the nav and the CTA sharing a row. */
    .site-header nav summary {
      font-size: 0.9rem;
    }

    .nav-cta {
      padding: 0.45rem 0.95rem;
      font-size: 0.8125rem;
    }
  }

  a {
    color: inherit;
  }

  ::selection {
    background: var(--color-accent);
    color: var(--color-ink);
  }
</style>
