---
import Layout from "../../../layouts/Layout.astro";
import {
  getCategories,
  countCategoryItems,
  isPremiumCategory,
  localeFromSlug,
  localePath,
  getLocaleInfo,
  LOCALES,
} from "../../../lib/content";

// One template serves all three editions. Spanish uses an empty `lang`, so it
// keeps the already-indexed /scenarios URL; the others get /sv and /de.
export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l.slug || undefined } }));
}

const locale = localeFromSlug(Astro.params.lang);
if (!locale) {
  return new Response("Not found", { status: 404 });
}

const info = getLocaleInfo(locale);

// Free categories first, paywalled ones grouped at the bottom (stable sort
// keeps each group in its original order).
const categories = getCategories(locale).sort(
  (a, b) => Number(isPremiumCategory(a.id)) - Number(isPremiumCategory(b.id))
);
---

<Layout
  title={`${info.language} scenarios — Try Convi`}
  description={`All Try Convi ${info.language} scenario categories.`}
  locale={locale}
>
  <h1>{info.flag} {info.language} scenarios</h1>
  <p class="intro">Pick a category and see how the conversation actually goes.</p>

  <p class="intro-hint">Open a category and it gets marked complete here.</p>

  <div class="grid">
    {
      categories.map((category) => (
        <a
          class="card"
          href={localePath(locale, `/scenarios/${category.id}`)}
          data-category-id={category.id}
          data-premium={isPremiumCategory(category.id) ? "true" : undefined}
        >
          <span class="title">{category.title}</span>
          <span class="card-foot">
            <span class="meta">
              {category.type === "dialogue" ? "Dialogue" : "Phrasebook"} · {countCategoryItems(category)} items
            </span>
            <span class="badge" hidden>Completed</span>
            {isPremiumCategory(category.id) && <span class="lock" hidden>Paid</span>}
          </span>
        </a>
      ))
    }
  </div>
</Layout>

<style>
  h1 {
    margin-bottom: 0.25rem;
    font-size: 1.9rem;
  }

  .intro {
    color: var(--color-ink-soft);
    margin: 0 0 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.85rem;
  }

  /* Once the grid is two columns, drop a lone final card (odd count) into
     the right-hand column instead of leaving it alone on the left. */
  @media (min-width: 448px) {
    .card:last-child:nth-child(odd) {
      grid-column: 2;
    }
  }

  .intro-hint {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    margin: -0.5rem 0 1.25rem;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem;
    min-height: 6rem;
    border-radius: 16px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: transform 0.12s ease, border-color 0.12s ease;
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
  }

  .card.completed {
    border-color: var(--color-success);
    background: var(--color-success-bg);
  }

  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin-top: auto;
  }

  .badge,
  .lock {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }

  .badge {
    color: var(--color-success);
    background: var(--color-card);
    border: 1px solid var(--color-success);
  }

  .lock {
    color: var(--color-primary-dark);
    background: var(--color-primary-tint);
    border: 1px solid var(--color-primary-tint-border);
  }

  .title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .meta {
    font-size: 0.8rem;
    color: var(--color-ink-soft);
    /* Stays on one line; the tag wraps beneath it on a cramped card instead. */
    white-space: nowrap;
  }
</style>

<script>
  (async () => {
    let unlocked = false;
    try {
      const res = await fetch("/api/entitlement");
      unlocked = !!(await res.json()).entitled;
    } catch {}

    try {
      const raw = localStorage.getItem("convi:progress:v1");
      const visited: string[] = raw ? JSON.parse(raw).visitedCategoryIds ?? [] : [];
      document.querySelectorAll<HTMLElement>(".card[data-category-id]").forEach((card) => {
        const id = card.dataset.categoryId;
        const premium = card.dataset.premium === "true";

        if (premium && !unlocked) {
          const lock = card.querySelector(".lock");
          if (lock) lock.removeAttribute("hidden");
          return; // don't show a completed badge on a still-locked category
        }

        if (id && visited.includes(id)) {
          card.classList.add("completed");
          const badge = card.querySelector(".badge");
          if (badge) badge.removeAttribute("hidden");
        }
      });
    } catch {}
  })();
</script>
