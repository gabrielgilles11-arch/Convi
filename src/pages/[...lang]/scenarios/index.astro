---
import Layout from "../../../layouts/Layout.astro";
import {
  getCategories,
  countCategoryItems,
  isPremiumCategory,
  localeFromSlug,
  localePath,
  getLocaleInfo,
  LOCALES,
} from "../../../lib/content";

// One template serves all three editions. Spanish uses an empty `lang`, so it
// keeps the already-indexed /scenarios URL; the others get /sv and /de.
export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l.slug || undefined } }));
}

const locale = localeFromSlug(Astro.params.lang);
if (!locale) {
  return new Response("Not found", { status: 404 });
}

const info = getLocaleInfo(locale);

// Free categories first, paywalled ones grouped at the bottom (stable sort
// keeps each group in its original order).
const categories = getCategories(locale).sort(
  (a, b) => Number(isPremiumCategory(a.id)) - Number(isPremiumCategory(b.id))
);
---

<Layout
  title={`${info.language} phrases for real conversations in ${info.region}`}
  description={`Every ${info.language} conversation you'll actually have in ${info.region}, from ordering and taxis to slang and nightlife, with what they'll say back. ${categories.length} free scenario packs, no sign-up.`}
  locale={locale}
>
  <h1>{info.flag} {info.language} scenarios</h1>
  <p class="intro">Pick a category and see how the conversation actually goes.</p>

  <p class="intro-hint">Open a category and it gets marked complete here.</p>

  <div class="grid">
    {
      categories.map((category, i) => (
        <a
          class={`card hue-${(i % 4) + 1}`}
          href={localePath(locale, `/scenarios/${category.id}`)}
          data-category-id={category.id}
          data-premium={isPremiumCategory(category.id) ? "true" : undefined}
        >
          <span class="card-mark" aria-hidden="true">
            {category.type === "dialogue" ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 5.5h11a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H9l-4 3v-3a2 2 0 0 1-2-2v-5a2 2 0 0 1 1-1.7" />
                <path d="M19 9.5h1a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2v2.5l-3-2.5" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4.5 7h15M4.5 12h15M4.5 17h9" />
              </svg>
            )}
          </span>
          <span class="title">{category.title}</span>
          <span class="card-foot">
            <span class="meta">
              {category.type === "dialogue" ? "Dialogue" : "Phrasebook"} · {countCategoryItems(category)} items
            </span>
            <span class="badge" hidden>Completed</span>
            {isPremiumCategory(category.id) && <span class="lock" hidden>Paid</span>}
          </span>
        </a>
      ))
    }
  </div>
</Layout>

<style>
  h1 {
    margin-bottom: 0.25rem;
    font-size: 1.9rem;
  }

  .intro {
    color: var(--color-ink-soft);
    margin: 0 0 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.85rem;
  }

  /* Once the grid is two columns, drop a lone final card (odd count) into
     the right-hand column instead of leaving it alone on the left. */
  @media (min-width: 448px) {
    .card:last-child:nth-child(odd) {
      grid-column: 2;
    }
  }

  .intro-hint {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    margin: -0.5rem 0 1.25rem;
  }

  /* Cards cycle through the same four hues the answer choices use, so a
     category is something you recognise by colour before you read it. Each card
     sets the three variables once and everything below reads them. */
  .card {
    --hue: var(--opt-a);
    --hue-deep: var(--opt-a-deep);
    --hue-tint: var(--opt-a-tint);
    --hue-fill: var(--opt-a-deep);
    --hue-on: #fff;

    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem;
    padding-top: 1.5rem;
    border-radius: 20px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: transform 0.14s ease, border-color 0.14s ease, box-shadow 0.14s ease;
  }

  .card.hue-2 {
    --hue: var(--opt-b);
    --hue-deep: var(--opt-b-deep);
    --hue-tint: var(--opt-b-tint);
    --hue-fill: var(--opt-b-deep);
    --hue-on: #fff;
  }

  .card.hue-3 {
    --hue: var(--opt-c);
    --hue-deep: var(--opt-c-deep);
    --hue-tint: var(--opt-c-tint);
    --hue-fill: var(--opt-c-deep);
    --hue-on: #fff;
  }

  /* Amber fills bright and carries ink — darkened far enough for white text it
     goes olive. Same exception the answer choices make. */
  .card.hue-4 {
    --hue: var(--opt-d);
    --hue-deep: var(--opt-d-deep);
    --hue-tint: var(--opt-d-tint);
    --hue-fill: var(--opt-d);
    --hue-on: var(--color-ink);
  }

  /* A band of the card's colour across the top edge — enough to identify the
     card at a glance without tinting the text behind it. */
  .card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    background: var(--hue);
  }

  .card-mark {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 12px;
    background: var(--hue-tint);
    color: var(--hue-deep);
    transition: background-color 0.14s ease, color 0.14s ease;
  }

  .card-mark svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  /* Gated on a real pointer: a tap leaves :hover stuck on a touchscreen, so a
     card you opened and came back from would still be lifted. */
  @media (hover: hover) {
    .card:hover {
      transform: translateY(-3px);
      border-color: var(--hue);
      box-shadow: 0 16px 26px -18px var(--hue);
    }

    .card:hover .card-mark {
      background: var(--hue-fill);
      color: var(--hue-on);
    }
  }

  .card:focus-visible {
    outline: 3px solid var(--hue-deep);
    outline-offset: 3px;
  }

  .card.completed {
    border-color: var(--color-success);
    background: var(--color-success-bg);
  }

  .card.completed::before {
    background: var(--color-success-deep);
  }

  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .badge,
  .lock {
    flex-shrink: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }

  .badge {
    color: #fff;
    background: var(--color-success-deep);
    border: 1px solid var(--color-success-deep);
  }

  .lock {
    color: #fff;
    background: var(--color-primary-dark);
    border: 1px solid var(--color-primary-dark);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.25;
    margin-top: 0.15rem;
  }

  .meta {
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
    /* Stays on one line; the tag wraps beneath it on a cramped card instead. */
    white-space: nowrap;
  }
</style>

<script>
  (async () => {
    let unlocked = false;
    try {
      const res = await fetch("/api/entitlement");
      unlocked = !!(await res.json()).entitled;
    } catch {}

    try {
      const raw = localStorage.getItem("convi:progress:v1");
      const visited: string[] = raw ? JSON.parse(raw).visitedCategoryIds ?? [] : [];
      document.querySelectorAll<HTMLElement>(".card[data-category-id]").forEach((card) => {
        const id = card.dataset.categoryId;
        const premium = card.dataset.premium === "true";

        if (premium && !unlocked) {
          const lock = card.querySelector(".lock");
          if (lock) lock.removeAttribute("hidden");
          return; // don't show a completed badge on a still-locked category
        }

        if (id && visited.includes(id)) {
          card.classList.add("completed");
          const badge = card.querySelector(".badge");
          if (badge) badge.removeAttribute("hidden");
        }
      });
    } catch {}
  })();
</script>
