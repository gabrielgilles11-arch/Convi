---
import Layout from "../../../layouts/Layout.astro";
import ScenarioGate from "../../../components/ScenarioGate";
import {
  getCategoryById,
  isDialogueSubsection,
  isPremiumCategory,
  localeFromSlug,
  localePath,
  type DialogueSubsection,
  type PhrasebookSubsection,
} from "../../../lib/content";
import { ENT_COOKIE, verifyEntitlement } from "../../../lib/entitlement";

// Rendered on demand so premium content can be gated per-request: locked
// content is never sent to the browser for unentitled visitors.
export const prerender = false;

const locale = localeFromSlug(Astro.params.lang);
if (!locale) {
  return new Response("Not found", { status: 404 });
}

// Scoped to the locale on purpose: /sv/scenarios/cuss-words (a Spanish id)
// must 404 rather than render Spanish content under a Swedish URL.
const category = getCategoryById(Astro.params.id ?? "", locale);
if (!category) {
  return new Response("Not found", { status: 404 });
}

const isPremium = isPremiumCategory(category.id);
const entitled = !!verifyEntitlement(Astro.cookies.get(ENT_COOKIE)?.value);
const showContent = !isPremium || entitled;

const gateCopy =
  category.id === "for-the-girls"
    ? {
        heading: "For the girls",
        body: "Learn how to recognize and deal with creeps and ask for help in Spain. For a small one-time purchase you unlock this pack — and you also unlock the full Practice section. Yours forever.",
      }
    : {};
---

<Layout title={`${category.title} — Try Convi`} description={category.description} locale={locale}>
  <a class="back" href={localePath(locale, "/scenarios")}>&larr; All scenarios</a>
  <h1><span class="icon">{category.icon}</span> {category.title}</h1>
  <p class="description">{category.description}</p>

  {isPremium && !entitled && <ScenarioGate client:load {...gateCopy} />}

  {showContent && (
  <div id="premium-content">
  {
    category.note && category.note.es && (
      <div class="note">
        <p>{category.note.es}</p>
        {category.note.en && <p class="translation">{category.note.en}</p>}
      </div>
    )
  }

  {
    category.subsections.map((sub) => (
      isDialogueSubsection(sub) ? (
        <section class="subsection">
          {(sub as DialogueSubsection).title && <h2>{(sub as DialogueSubsection).title}</h2>}

          {(sub as DialogueSubsection).exchanges?.map((exchange) => (
            <article class="exchange">
              <p class="question">
                <span class="label">Q</span> {exchange.question.es}
                <span class="translation"> — {exchange.question.en}</span>
                {exchange.region === "madrid" && <span class="tag tag--madrid">Madrid</span>}
                {exchange.region === "barcelona" && <span class="tag tag--barcelona">Barcelona</span>}
                {exchange.region === "stockholm" && <span class="tag tag--stockholm">Stockholm</span>}
                {exchange.region === "bayern" && <span class="tag tag--bayern">Bayern</span>}
                {exchange.young && <span class="tag tag--young">young</span>}
                {exchange.women && <span class="tag tag--women">women</span>}
              </p>

              {exchange.answers.length > 0 && (
                <ul class="answers">
                  {exchange.answers.map((answer) => (
                    <li>
                      <span class="label">A</span> {answer.es}
                      <span class="translation"> — {answer.en}</span>
                    </li>
                  ))}
                </ul>
              )}

              {exchange.likelyReply && (
                <p class="reply">
                  <span class="label">They'll say</span> {exchange.likelyReply.es}
                  <span class="translation"> — {exchange.likelyReply.en}</span>
                </p>
              )}

              {exchange.notes && <p class="notes">{exchange.notes}</p>}
            </article>
          ))}

          {(sub as DialogueSubsection).items?.map((tip) => (
            <p class="tip">
              {tip.es} <span class="translation">— {tip.en}</span>
            </p>
          ))}
        </section>
      ) : (
        <section class="subsection">
          <h2>{(sub as PhrasebookSubsection).title}</h2>
          <ul class="phrases">
            {(sub as PhrasebookSubsection).phrases.map((phrase) => (
              <li>
                <span class="es">
                  {phrase.es}
                  {phrase.region === "madrid" && <span class="tag tag--madrid">Madrid</span>}
                  {phrase.region === "barcelona" && <span class="tag tag--barcelona">Barcelona</span>}
                  {phrase.region === "stockholm" && <span class="tag tag--stockholm">Stockholm</span>}
                  {phrase.region === "bayern" && <span class="tag tag--bayern">Bayern</span>}
                  {phrase.young && <span class="tag tag--young">young</span>}
                </span>
                <span class="translation">{phrase.en}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    ))
  }
  </div>
  )}
</Layout>

<script define:vars={{ categoryId: category.id, showContent }}>
  // Mark this category "completed" once its content has actually been shown
  // (free categories, or premium ones the visitor is entitled to).
  const KEY = "convi:progress:v1";
  if (showContent) {
    try {
      const parsed = JSON.parse(localStorage.getItem(KEY) || "{}");
      const visited = parsed.visitedCategoryIds ?? [];
      if (!visited.includes(categoryId)) {
        visited.push(categoryId);
        parsed.visitedCategoryIds = visited;
        localStorage.setItem(KEY, JSON.stringify(parsed));
      }
    } catch {}
  }
</script>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-primary-dark);
  }

  h1 {
    margin: 0 0 0.25rem;
    font-size: 1.7rem;
  }

  .icon {
    margin-right: 0.25rem;
  }

  .description {
    color: var(--color-ink-soft);
    margin: 0 0 1.5rem;
  }

  .note {
    background: var(--color-primary-tint);
    border: 1px solid var(--color-primary-tint-border);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    margin-bottom: 1.5rem;
  }

  .note p {
    margin: 0;
  }

  .subsection {
    margin-bottom: 2rem;
  }

  .subsection h2 {
    font-size: 1.1rem;
    margin: 0 0 0.75rem;
    color: var(--color-primary-dark);
  }

  .exchange {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1rem;
    margin-bottom: 0.75rem;
  }

  .exchange p,
  .exchange ul {
    margin: 0 0 0.5rem;
  }

  .exchange p:last-child,
  .exchange ul:last-child {
    margin-bottom: 0;
  }

  .answers {
    list-style: none;
    padding: 0;
  }

  .answers li {
    margin-bottom: 0.25rem;
  }

  .label {
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-right: 0.25rem;
  }

  .translation {
    color: var(--color-ink-soft);
    font-size: 0.9rem;
  }

  .notes {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-ink-soft);
  }

  .tip {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .phrases {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .phrases li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 0.75rem 1rem;
  }

  .phrases .es {
    font-weight: 600;
  }

  .tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    margin-left: 0.4rem;
    vertical-align: middle;
    white-space: nowrap;
  }

  .tag--madrid {
    background: #e8622c;
    color: #fff;
  }

  .tag--barcelona {
    background: #1a5fb4;
    color: #fff;
  }

  .tag--stockholm {
    background: #2f6fa8;
    color: #fff;
  }

  .tag--bayern {
    background: #3a6ea5;
    color: #fff;
  }

  .tag--young {
    background: var(--color-primary-tint);
    color: var(--color-primary-dark);
    border: 1px solid var(--color-primary-tint-border);
  }

  .tag--women {
    background: #8a4fbe;
    color: #fff;
  }
</style>
