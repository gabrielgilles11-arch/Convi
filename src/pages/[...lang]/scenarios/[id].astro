---
import Layout from "../../../layouts/Layout.astro";
import ScenarioGate from "../../../components/ScenarioGate";
import Speaker from "../../../components/Speaker.astro";
import buzzwords from "../../../../content/buzzwords.json";
import {
  getCategories,
  getCategoryById,
  getLocaleInfo,
  LOCALES,
  isDialogueSubsection,
  isPremiumCategory,
  localeFromSlug,
  localePath,
  quickAnswer,
  REGION_LABELS,
  searchBlurb,
  searchTitle,
  type DialogueSubsection,
  type PhrasebookSubsection,
} from "../../../lib/content";
import { ENT_COOKIE, verifyEntitlement } from "../../../lib/entitlement";

import { PAYWALL_ENABLED } from "../../../lib/paywall";

/**
 * Static while nothing is paid; rendered per request the moment something is.
 *
 * These pages are the front door — the search-intent titles, the answer-first
 * block and the LearningResource schema all live here — and a page that is not
 * built is a page the sitemap cannot list. That is exactly what had happened:
 * the sitemap held twelve URLs and not one of the forty scenario pages, because
 * this route was rendered on demand so that premium categories could be gated
 * per request. There are no premium categories while PAYWALL_ENABLED is false,
 * so it was paying the whole cost of a gate that was switched off.
 *
 * Reinstating the paywall is still one line. Flipping that flag flips this
 * back to per-request rendering and the entitlement check below starts
 * running again; Astro then warns that getStaticPaths is ignored, which is the
 * correct thing for it to say and costs nothing.
 */
export const prerender = !PAYWALL_ENABLED;

export function getStaticPaths() {
  return LOCALES.flatMap((l) =>
    getCategories(l.locale).map((category) => ({
      params: { lang: l.slug || undefined, id: category.id },
    }))
  );
}

const locale = localeFromSlug(Astro.params.lang);
if (!locale) {
  return new Response("Not found", { status: 404 });
}

// Scoped to the locale on purpose: /sv/scenarios/cuss-words (a Spanish id)
// must 404 rather than render Spanish content under a Swedish URL.
const category = getCategoryById(Astro.params.id ?? "", locale);
if (!category) {
  return new Response("Not found", { status: 404 });
}

const isPremium = isPremiumCategory(category.id);
// Only asked when the answer can be anything but false. A prerendered page has
// no request to read a cookie from, and there is nothing to be entitled to
// while the paywall is off.
const entitled =
  PAYWALL_ENABLED && !!verifyEntitlement(Astro.cookies.get(ENT_COOKIE)?.value);
const showContent = !isPremium || entitled;

const gateCopy =
  category.id === "for-the-girls"
    ? {
        heading: "For the girls",
        body: "Learn how to recognize and deal with creeps and ask for help in Spain.",
      }
    : {};
const info = getLocaleInfo(locale);
const pageTitle = searchTitle(category, locale);
const pageBlurb = searchBlurb(category, locale);
const answer = quickAnswer(category);
// One link per category, not a permalink on every line: enough for the words
// page to be reachable and to carry weight, without touching how the exchanges
// below are laid out.
const wordSet = (buzzwords as unknown as Record<string, { title: string } | undefined>)[category.id];
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// BreadcrumbList still earns a search appearance; LearningResource is the
// honest description of what this page is, and gives an answer engine the
// language and the subject without having to guess them from the prose.
const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Try Convi", item: Astro.site?.href },
      {
        "@type": "ListItem",
        position: 2,
        name: `${info.language} scenarios`,
        item: new URL(localePath(locale, "/scenarios"), Astro.site).href,
      },
      { "@type": "ListItem", position: 3, name: category.title, item: pageUrl },
    ],
  },
  {
    "@type": "LearningResource",
    "@id": `${pageUrl}#resource`,
    name: pageTitle,
    description: pageBlurb,
    url: pageUrl,
    inLanguage: "en",
    teaches: `${info.language} phrases for ${category.title.toLowerCase()}`,
    about: { "@type": "Language", name: info.language },
    learningResourceType: "Phrasebook",
    educationalLevel: "Beginner",
    isAccessibleForFree: true,
    audience: { "@type": "Audience", audienceType: "Travellers" },
  },
];
---

<Layout title={pageTitle} description={pageBlurb} locale={locale} schema={schema}>
  <a class="back" href={localePath(locale, "/scenarios")}>&larr; All scenarios</a>
  <div class="title-row" data-locale={locale}>
    <h1>{category.title}</h1>
    {/* Hidden until the script knows this device can say anything at all. */}
    <button type="button" id="voice-toggle" class="voice-toggle" aria-pressed="true" hidden>
      <span class="toggle-label">Voices</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M7 9.5c1.6-2 3.2-3 5-3s3.4 1 5 3"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
        />
        <path
          d="M6 13c2 3 4 4.5 6 4.5s4-1.5 6-4.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
        />
      </svg>
    </button>
  </div>
  <p class="description">{category.description}</p>

  {/* Answer-first: the one line that answers the search, before anything else
      on the page. A reader who only wanted that can stop here, and an answer
      engine quoting the page has something to quote. */}
  {
    wordSet && (
      <a class="words-link" href={localePath(locale, `/scenarios/${category.id}/words`)}>
        <span class="words-link-label">{wordSet.title}</span>
        <span class="words-link-sub">What each one means, one by one &rarr;</span>
      </a>
    )
  }

  {
    answer && (
      <p class="quick-answer">
        <span class="quick-answer-label">Short answer</span>
        <span class="quick-answer-line">
          In {info.region}, say <strong>{answer.es}</strong>
          {answer.en && <span class="quick-answer-en"> — {answer.en}</span>}
        </span>
      </p>
    )
  }

  {isPremium && !entitled && <ScenarioGate client:load {...gateCopy} />}

  {showContent && (
  <div id="premium-content">
  {
    category.note && category.note.es && (
      <div class="note">
        <p>{category.note.es}</p>
        {category.note.en && <p class="translation">{category.note.en}</p>}
      </div>
    )
  }

  {
    category.subsections.map((sub) => (
      isDialogueSubsection(sub) ? (
        <section class="subsection">
          {(sub as DialogueSubsection).title && <h2>{(sub as DialogueSubsection).title}</h2>}

          {(sub as DialogueSubsection).exchanges?.map((exchange) => (
            <article class="exchange">
              <p class="question">
                <span class="label">Q</span> {exchange.question.es}
                <Speaker audioId={`${exchange.id}-q`} text={exchange.question.es} label="Hear the question" />
                <span class="translation"> — {exchange.question.en}</span>
                {exchange.region && (
                  <span class={`tag tag--${exchange.region}`}>{REGION_LABELS[exchange.region]}</span>
                )}
                {exchange.young && <span class="tag tag--young">young</span>}
                {exchange.women && <span class="tag tag--women">women</span>}
              </p>

              {exchange.answers.length > 0 && (
                <ul class="answers">
                  {exchange.answers.map((answer, i) => (
                    <li>
                      <span class="label">A</span> {answer.es}
                      <Speaker audioId={`${exchange.id}-a${i}`} text={answer.es} label="Hear this answer" />
                      <span class="translation"> — {answer.en}</span>
                    </li>
                  ))}
                </ul>
              )}

              {exchange.likelyReply && (
                <p class="reply">
                  <span class="label">They'll say</span> {exchange.likelyReply.es}
                  <Speaker audioId={`${exchange.id}-r`} text={exchange.likelyReply.es} label="Hear their reply" />
                  <span class="translation"> — {exchange.likelyReply.en}</span>
                </p>
              )}

              {exchange.notes && <p class="notes">{exchange.notes}</p>}
            </article>
          ))}

          {(sub as DialogueSubsection).items?.map((tip, i) => (
            <p class="tip">
              {tip.es}
              <Speaker audioId={`${sub.id}-tip${i}`} text={tip.es} />
              <span class="translation">— {tip.en}</span>
            </p>
          ))}
        </section>
      ) : (
        <section class="subsection">
          <h2>{(sub as PhrasebookSubsection).title}</h2>
          <ul class="phrases">
            {(sub as PhrasebookSubsection).phrases.map((phrase) => (
              <li>
                <span class="es">
                  {phrase.es}
                  <Speaker audioId={phrase.id} text={phrase.es} />
                  {phrase.region && (
                    <span class={`tag tag--${phrase.region}`}>{REGION_LABELS[phrase.region]}</span>
                  )}
                  {phrase.young && <span class="tag tag--young">young</span>}
                </span>
                <span class="translation">{phrase.en}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    ))
  }
  </div>
  )}
</Layout>

<script>
  // Reading the scenario out loud. One delegated handler for the whole page:
  // a long phrasebook can carry a hundred speakers, and a hundred listeners is
  // a hundred things to tear down.
  import {
    canSpeak,
    hasClip,
    onVoicesReady,
    setVoiceEnabled,
    speak,
    stopSpeaking,
    subscribeVoice,
    voiceEnabled,
  } from "../../../components/quiz/speech";

  // The locale is a server value, so it travels in the markup rather than in
  // this module — a bundled script has no way to be handed one.
  const locale = document.querySelector<HTMLElement>(".title-row")?.dataset.locale ?? "es-ES";
  const toggle = document.getElementById("voice-toggle") as HTMLButtonElement | null;
  const buttons = () => document.querySelectorAll<HTMLButtonElement>(".speak");

  /** True once anything on this device can say a line in this language. */
  let sayable = canSpeak(locale);

  function sync() {
    const on = voiceEnabled() && sayable;
    for (const button of buttons()) button.hidden = !on;
    if (toggle) {
      toggle.hidden = !sayable;
      toggle.setAttribute("aria-pressed", String(voiceEnabled()));
      toggle.title = voiceEnabled() ? "Voices on" : "Voices off";
    }
  }

  // A generated clip counts even where the browser has no voice of its own, so
  // one representative line is probed before giving up on the whole page.
  const first = document.querySelector<HTMLButtonElement>(".speak");
  if (!sayable && first?.dataset.audio) {
    void hasClip(locale, first.dataset.audio).then((found) => {
      if (!found) return;
      sayable = true;
      sync();
    });
  }

  onVoicesReady(() => {
    sayable = canSpeak(locale);
    sync();
  });
  subscribeVoice(sync);

  toggle?.addEventListener("click", () => {
    const next = toggle.getAttribute("aria-pressed") !== "true";
    setVoiceEnabled(next);
    if (!next) stopSpeaking();
    sync();
  });

  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(".speak");
    if (!button) return;
    const text = button.dataset.text ?? "";
    button.dataset.speaking = "true";
    // "scenarios" is what puts the recorded clips on this page and leaves
    // practice on the device voice — see Surface in speech.ts.
    void speak(locale, button.dataset.audio || null, text, "scenarios").finally(() => {
      delete button.dataset.speaking;
    });
  });

  sync();
</script>

<script is:inline define:vars={{ categoryId: category.id, showContent }}>
  // Mark this category "completed" once its content has actually been shown
  // (free categories, or premium ones the visitor is entitled to).
  const KEY = "convi:progress:v1";
  if (showContent) {
    try {
      const parsed = JSON.parse(localStorage.getItem(KEY) || "{}");
      const visited = parsed.visitedCategoryIds ?? [];
      if (!visited.includes(categoryId)) {
        visited.push(categoryId);
        parsed.visitedCategoryIds = visited;
        localStorage.setItem(KEY, JSON.stringify(parsed));
      }
    } catch {}
  }
</script>

<style>
  .back {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-primary-tint-border);
    background: var(--color-primary-tint);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-primary-dark);
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .back:hover {
    background: var(--color-primary);
    color: #fff;
  }

  /* Title and the voices switch on one line: the switch belongs to the page,
     not to any single phrase on it. */
  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .voice-toggle {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    padding: 0.4rem 0.75rem;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
    cursor: pointer;
  }

  .voice-toggle[aria-pressed="true"] {
    border-color: var(--color-primary-tint-border);
    background: var(--color-primary-tint);
  }

  .voice-toggle[aria-pressed="false"] {
    color: var(--color-ink-soft);
  }

  .voice-toggle svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  /* The mouth closes when voices are off — the same shape saying nothing. */
  .voice-toggle[aria-pressed="false"] svg path:first-child {
    opacity: 0.25;
  }

  .words-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0 0 1rem;
    border-radius: 14px;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    padding: 0.75rem 1rem;
    text-decoration: none;
  }

  .words-link:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-tint);
  }

  .words-link-label {
    font-weight: 800;
    color: var(--color-primary-dark);
  }

  .words-link-sub {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  /* The short answer sits above the fold and reads as the page's thesis. */
  .quick-answer {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin: 0 0 1.5rem;
    border-left: 4px solid var(--color-primary);
    border-radius: 0 14px 14px 0;
    background: var(--color-primary-tint);
    padding: 0.85rem 1rem;
  }

  .quick-answer-label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
  }

  .quick-answer-line {
    font-size: 1.05rem;
    line-height: 1.4;
  }

  .quick-answer-line strong {
    font-family: var(--font-display);
  }

  .quick-answer-en {
    color: var(--color-ink-soft);
  }

  h1 {
    margin: 0 0 0.25rem;
    font-size: 1.7rem;
  }

  .description {
    color: var(--color-ink-soft);
    margin: 0 0 1.5rem;
  }

  .note {
    background: var(--color-primary-tint);
    border: 1px solid var(--color-primary-tint-border);
    border-radius: 18px;
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.5rem;
  }

  .note p {
    margin: 0;
  }

  .subsection {
    margin-bottom: 2rem;
  }

  /* Section headings get the accent bar rather than a colour change alone —
     at 1.1rem a coloured heading on cream is doing too little work. */
  .subsection h2 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.1rem;
    margin: 0 0 0.85rem;
    color: var(--color-primary-dark);
  }

  .subsection h2::before {
    content: "";
    flex: none;
    width: 0.35rem;
    height: 1.15rem;
    border-radius: 999px;
    background: var(--color-primary);
  }

  /* Every line of content sits on white. Black-on-cream over a whole page of
     dialogue is what made this hard to read; the cream is now only the ground
     the cards sit on. */
  .exchange {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 1.1rem 1.2rem;
    margin-bottom: 0.75rem;
    box-shadow: 0 10px 22px -20px rgba(36, 22, 16, 0.6);
  }

  .exchange p,
  .exchange ul {
    margin: 0 0 0.6rem;
  }

  .exchange p:last-child,
  .exchange ul:last-child {
    margin-bottom: 0;
  }

  .answers {
    list-style: none;
    padding: 0;
  }

  /* Spaced so the speaker buttons on two consecutive lines cannot both claim
     the same finger. See the note in Speaker.astro. */
  .answers li {
    margin-bottom: 0.75rem;
  }

  .answers li:last-child {
    margin-bottom: 0;
  }

  /* Q, A and "They'll say" are the three voices in an exchange, so each gets
     its own colour and they stay consistent down the page. */
  .label {
    display: inline-grid;
    place-items: center;
    min-width: 1.4rem;
    height: 1.4rem;
    padding: 0 0.45rem;
    border-radius: 999px;
    background: var(--opt-a-deep);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    vertical-align: middle;
    margin-right: 0.4rem;
  }

  .answers .label {
    background: var(--opt-c-deep);
  }

  .reply .label {
    background: var(--opt-b-deep);
  }

  /* Far enough below the last answer that the two speaker buttons cannot both
     claim the same tap. Needs `.exchange` in front of it to outrank the
     blanket paragraph margin above. See the note in Speaker.astro. */
  .exchange .reply {
    margin-top: 0.95rem;
  }

  .question {
    font-weight: 600;
  }

  .translation {
    color: var(--color-ink-soft);
    font-size: 0.9rem;
  }

  .notes {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-ink-soft);
    padding-top: 0.5rem;
    border-top: 1px dashed var(--color-border);
  }

  .tip {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--opt-d);
    border-radius: 14px;
    padding: 0.7rem 0.9rem;
    margin: 0 0 0.5rem;
  }

  .phrases {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Rows cycle the same four hues as everything else — a phrasebook is a long
     list of near-identical lines, and one repeated accent colour down all of
     them just reads as a ruled margin. */
  .phrases li {
    --row: var(--opt-a);

    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--row);
    border-radius: 14px;
    padding: 0.8rem 1rem;
    transition: box-shadow 0.12s ease, transform 0.12s ease;
  }

  .phrases li:nth-child(4n + 2) {
    --row: var(--opt-b);
  }

  .phrases li:nth-child(4n + 3) {
    --row: var(--opt-c);
  }

  .phrases li:nth-child(4n + 4) {
    --row: var(--opt-d);
  }

  @media (hover: hover) {
    .phrases li:hover {
      transform: translateX(2px);
      box-shadow: 0 10px 20px -18px rgba(36, 22, 16, 0.9);
    }
  }

  .phrases .es {
    font-weight: 700;
  }

  .tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    margin-left: 0.4rem;
    vertical-align: middle;
    white-space: nowrap;
  }

  .tag--madrid {
    background: #c9491f;
    color: #fff;
  }

  .tag--barcelona {
    background: #1a5fb4;
    color: #fff;
  }

  .tag--catalan {
    background: #96690c;
    color: #fff;
  }

  .tag--stockholm {
    background: #2f6fa8;
    color: #fff;
  }

  .tag--bayern {
    background: #3a6ea5;
    color: #fff;
  }

  .tag--bayerisch {
    background: #26527d;
    color: #fff;
  }

  .tag--berlin {
    background: #b02a2a;
    color: #fff;
  }

  .tag--young {
    background: var(--opt-c-deep);
    color: #fff;
  }

  .tag--women {
    background: #7a3fae;
    color: #fff;
  }
</style>
