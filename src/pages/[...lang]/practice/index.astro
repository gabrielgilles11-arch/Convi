---
import Layout from "../../../layouts/Layout.astro";
import PracticeGate from "../../../components/PracticeGate";
import { localeFromSlug, getLocaleInfo, LOCALES } from "../../../lib/content";

// Every language's practice section is paywalled the same way: the deck comes
// from /api/quiz-items, which checks the entitlement cookie server-side.
export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l.slug || undefined } }));
}

const locale = localeFromSlug(Astro.params.lang);
if (!locale) {
  return new Response("Not found", { status: 404 });
}

const info = getLocaleInfo(locale);
---

<Layout
  title={`Practise ${info.language} phrases — free drills, no sign-up`}
  description={`Drill the ${info.language} you'd actually use in ${info.region} along a guided path: real situations, matching pairs and typing. Free, no account.`}
  locale={locale}
>
  <h1>{info.flag} {info.language} practice</h1>
  <p class="intro">Work along the path, one round at a time.</p>

  <PracticeGate client:load locale={locale} />
</Layout>

<style>
  .intro {
    opacity: 0.75;
    margin: 0 0 1rem;
  }
</style>
