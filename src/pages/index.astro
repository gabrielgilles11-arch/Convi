---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import { getContent } from "../lib/content";

const { meta } = getContent();
---

<Layout>
  <section class="hero full-bleed">
    <div class="container">
      <p class="kicker">Don't learn "the house is red"</p>
      <Logo size="lg" />
      <h1 class="tagline">{meta.tagline}</h1>
      <p class="sub">
        Real Q&amp;A exchanges, slang, and "what they'll probably say back" —
        the actual way people really talk, not textbook language.
      </p>
      <div class="cta">
        <a class="button" href="/scenarios">Browse scenarios</a>
        <a class="button secondary" href="/practice">Try Practice</a>
      </div>
      <p class="language-note">🇪🇸 Spanish is live now — more languages coming soon.</p>
    </div>
  </section>

  <section class="explainer full-bleed">
    <div class="container">
      <h2>What is Try Convi?</h2>
      <p class="explainer-sub">
        A pocket phrasebook and quiz built from real conversations — not
        textbook Spanish. Browse for free, or unlock practice mode to make it stick.
      </p>
      <div class="tier-grid">
        <div class="tier-card">
          <span class="tier-badge">Free</span>
          <h3>Browse every scenario</h3>
          <p>
            All 7 conversation categories — Beer &amp; Food, Slang, Flirting,
            Getting Around, and more — free to read, anytime.
          </p>
          <ul>
            <li>Real phrases people actually say</li>
            <li>"What they'll probably say back"</li>
            <li>No sign-up required</li>
          </ul>
          <a class="button secondary" href="/scenarios">Browse scenarios</a>
        </div>
        <div class="tier-card tier-card--highlight">
          <span class="tier-badge tier-badge--accent">One-time purchase</span>
          <h3>Practice mode</h3>
          <p>
            Flashcards and multiple-choice quizzes across every scenario, so
            the phrases actually stick.
          </p>
          <ul>
            <li>Flip-card review for every phrase</li>
            <li>Multiple-choice quiz mode</li>
            <li>Pay once, yours forever</li>
          </ul>
          <a class="button" href="/practice">Unlock Practice</a>
        </div>
      </div>
    </div>
  </section>

  <section class="signup full-bleed">
    <div class="container">
      <h2>Get Try Convi in your pocket</h2>
      <p class="signup-sub">
        Sign up and we'll email you the moment the app (and printable phrasebook) is ready.
      </p>
      <form class="signup-form" id="signup-form">
        <input type="email" name="email" placeholder="you@email.com" required aria-label="Email address" />
        <button type="submit">Notify me</button>
      </form>
      <p class="signup-note" id="signup-note" hidden>Thanks — we'll let you know!</p>
      <p class="signup-error" id="signup-error" hidden>Something went wrong — try again in a moment.</p>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("signup-form") as HTMLFormElement | null;
  const note = document.getElementById("signup-note");
  const errorNote = document.getElementById("signup-error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (errorNote) errorNote.hidden = true;
    const email = (new FormData(form).get("email") as string) ?? "";

    try {
      const res = await fetch("/api/signup", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
      if (!res.ok) throw new Error("signup failed");
      form.hidden = true;
      if (note) note.hidden = false;
    } catch {
      if (errorNote) errorNote.hidden = false;
    }
  });
</script>

<style>
  .hero {
    background: #fff;
    margin-top: -1.5rem;
    padding: 3rem 0 3.5rem;
  }

  .hero .container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .kicker {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary-dark);
    background: #ffe6d5;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    margin: 0 0 1rem;
  }

  .tagline {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 1rem 0 0.75rem;
    max-width: 16ch;
  }

  .sub {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    color: var(--color-ink-soft);
    margin: 0 0 1.75rem;
    max-width: 46ch;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-heading);
    box-shadow: 0 4px 0 var(--color-primary-dark);
  }

  .button.secondary {
    background: transparent;
    color: var(--color-ink);
    border: 2px solid var(--color-ink);
    box-shadow: none;
  }

  @media (max-width: 480px) {
    .cta {
      flex-direction: column;
    }

    .button {
      text-align: center;
    }
  }

  .language-note {
    margin: 1.25rem 0 0;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  :global(main) {
    padding-bottom: 0;
  }

  .explainer {
    background: #fff;
    border-top: 1px solid var(--color-border);
    padding: 4rem 0;
  }

  .explainer .container {
    max-width: 960px;
  }

  .explainer h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 0.75rem;
  }

  .explainer-sub {
    color: var(--color-ink-soft);
    font-size: 1.05rem;
    max-width: 56ch;
    margin: 0 0 2.5rem;
  }

  .tier-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .tier-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .tier-card--highlight {
    border-color: var(--color-primary);
    box-shadow: 0 4px 0 var(--color-primary-dark);
  }

  .tier-badge {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-soft);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    margin: 0 0 1rem;
  }

  .tier-badge--accent {
    color: var(--color-primary-dark);
    background: #ffe6d5;
    border-color: transparent;
  }

  .tier-card h3 {
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
  }

  .tier-card > p {
    color: var(--color-ink-soft);
    margin: 0 0 1rem;
  }

  .tier-card ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tier-card li {
    padding-left: 1.4rem;
    position: relative;
    font-size: 0.95rem;
  }

  .tier-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  .tier-card .button {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (max-width: 720px) {
    .tier-grid {
      grid-template-columns: 1fr;
    }
  }

  .signup {
    background: #ffe6d5;
    padding: 3.5rem 0;
  }

  .signup .container {
    max-width: 560px;
  }

  .signup h2 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }

  .signup-sub {
    color: var(--color-ink-soft);
    margin: 0 0 1.25rem;
  }

  .signup-form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .signup-form input {
    flex: 1;
    min-width: 200px;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: 1rem;
    font-family: var(--font-body);
  }

  .signup-form input:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .signup-form button {
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    border: none;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    font-family: var(--font-heading);
    cursor: pointer;
    box-shadow: 0 4px 0 var(--color-primary-dark);
  }

  .signup-note {
    font-weight: 600;
    color: var(--color-primary-dark);
  }

  .signup-error {
    font-weight: 600;
    color: var(--color-error);
  }
</style>
