---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import LangMenu from "../components/LangMenu.astro";
import HeroDemo from "../components/HeroDemo.astro";
import ConviPeek from "../components/ConviPeek.astro";
import {
  LOCALES,
  countCategoryItems,
  getCategories,
  localePath,
  roughLineCount,
  DEFAULT_LOCALE,
} from "../lib/content";
import { LAST_LOCALE_KEY } from "../lib/lastLocale";
import { ROUND_LENGTH } from "../lib/quizTypes";

// Counts come from the content files so this copy can never drift out of date
// as categories are added to any edition.
const editions = LOCALES.map((l) => {
  const categories = getCategories(l.locale);
  return { ...l, total: categories.length, practice: localePath(l.locale, "/practice") };
});

const categoryCount = editions.reduce((n, e) => n + e.total, 0);

// One marquee band per edition, each led by its flag, so the strip itself shows
// which three languages the site covers. Flags come from LOCALES.
const MARQUEE_WORDS: Record<string, string[]> = {
  "es-ES": ["¿Qué tal?", "una caña, porfa", "¡qué guay!", "guiri", "¿me pones...?", "vale, vale", "tío", "¡flipas!", "sobremesa", "mola mazo", "en plan...", "resacón"],
  "sv-SE": ["asså", "typ", "Nu kör vi", "taggad", "sjukt", "fett", "skitbra", "vi tar tuben", "bärs", "ta en AW"],
  "de-DE": ["krass", "geil", "mega", "stabil", "läuft gut", "kein Bock", "Alter!", "Servus!", "Passt scho.", "Mei…"],
};

const marquee = editions.flatMap((e) => [
  { flag: e.flag, word: null },
  ...(MARQUEE_WORDS[e.locale] ?? []).map((word) => ({ flag: null, word })),
]);

/**
 * Where the hero's one button goes, per edition.
 *
 * Built here rather than in the browser so the script below never has to know
 * a slug table, and so a stored slug can be checked against real editions
 * before it is allowed anywhere near an href. Keyed by slug because that is
 * what the browser remembers.
 */
const startTargets = Object.fromEntries(
  LOCALES.map((l) => [
    l.slug,
    {
      practice: localePath(l.locale, "/practice"),
      scenarios: localePath(l.locale, "/scenarios"),
      label: `Start practicing ${l.language}`,
      flag: l.flag,
    },
  ])
);

// What the page ships with, for everyone arriving for the first time and for
// anyone with JavaScript off: the default edition, already a working link.
const defaultStart = startTargets[LOCALES.find((l) => l.locale === DEFAULT_LOCALE)!.slug];

/**
 * The home page's own title and description.
 *
 * It had neither, so it inherited the layout's fallback and went to search as
 * "Try Convi" — which names a site nobody has heard of and says nothing about
 * what is on it. Every other page on the site carries a search-intent title
 * built from its content; this one, the most linked page there is, was the
 * exception.
 *
 * The counts come from the content files for the same reason the copy below
 * does: a number typed into a meta tag is a number that goes stale silently.
 */
const lineCount = editions.reduce(
  (n, e) => n + getCategories(e.locale).reduce((m, c) => m + countCategoryItems(c), 0),
  0
);

/**
 * The same number, said the way a person says it.
 *
 * Still read from the content files, so it cannot drift; just not read out to
 * the digit. See `roughLineCount`.
 */
const roughLines = roughLineCount(lineCount);

const pageTitle = "Try Convi: Spanish, Swedish and German phrases for travelers";
// Starts a sentence here, and roughLineCount says it the way it sits mid-sentence
// ("over 1,000"), so the first letter is raised. Search results showed ". over".
const roughLinesSentence = roughLines.charAt(0).toUpperCase() + roughLines.slice(1);
const pageDescription = `Free Spanish, Swedish and German phrases for travelers: taxis, bars, slang, pharmacies, each with what people say back. ${roughLinesSentence} lines, no account needed.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="hero full-bleed">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow"><Logo size="sm" /> <span>· for travelers with somewhere to be</span></p>
        <h1 class="tagline">Speak like a local at a bar, restaurant, and in the metro.</h1>
        <div class="cta">
          {/* One tap into the language you were last reading — no menu, no
              second decision. The href and the label ship as the default
              edition and are rewritten below if this browser has a choice
              already. Picking a different language is still here, one step to
              the side, which is where a thing you do once belongs. */}
          <a class="button start-cta" id="start-cta" href={defaultStart.practice}>
            <span class="start-cta-flag" aria-hidden="true" id="start-cta-flag">{defaultStart.flag}</span>
            <span id="start-cta-label">{defaultStart.label}</span>
            <svg class="start-cta-arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <LangMenu path="/practice" label="Another language" variant="quiet" />
        </div>
        <p class="hero-alt">
          <a id="browse-cta" href={defaultStart.scenarios}>or read the scenarios first →</a>
        </p>
        <p class="sub">
          Spanish, Swedish and German the way locals actually speak them. Start
          with scenarios to learn how to navigate everyday life, or hop into
          practice to get conversational fast. No more speaking like a textbook.
        </p>
        {/* What the platform's word is worth, said plainly. Every line in the
            three languages comes from a published, cited source written by
            people who speak it (see content/SOURCES.md): none is generated. */}
        <ul class="trust" aria-label="About the phrases">
          <li>From native sources, never AI-written</li>
          <li>Every line spoken out loud</li>
          <li>Free, no account</li>
        </ul>
        <div class="editions">
          <p class="editions-label"><strong>Three editions live now.</strong></p>
          <ul class="edition-cards">
            {
              editions.map((e) => (
                <li>
                  <a class="edition-card" href={e.practice}>
                    <span class="edition-flag" aria-hidden="true">{e.flag}</span>
                    <span class="edition-text">
                      <span class="edition-lang">{e.language}</span>
                      <span class="edition-region">{e.region}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {/* No `reveal` on this one. The card runs its own entrance, and two
          fade-ins on the same element is the jank the demo was built to avoid. */}
      <div class="hero-art">
        {/* Convi hangs over the card's top edge. .hero-art reserves his
            height above it, so he never reaches the copy or the header. */}
        <div class="hero-convi"><ConviPeek /></div>
        <HeroDemo />
      </div>
    </div>
  </section>

  {/* Inline and right here on purpose: the button is a few lines above, and a
      bundled module script would run after first paint, so the label would be
      seen saying "Spanish" before it corrected itself. */}
  <script is:inline define:vars={{ startTargets, LAST_LOCALE_KEY }}>
    (() => {
      let slug;
      try {
        slug = window.localStorage.getItem(LAST_LOCALE_KEY);
      } catch {
        return; // Private mode. The default edition is already in the href.
      }
      // A stored value is a value from outside, and this one ends up in an
      // href. Only a slug that names a real edition gets used; anything else
      // leaves the default in place.
      if (slug === null || !Object.prototype.hasOwnProperty.call(startTargets, slug)) return;

      const target = startTargets[slug];
      const start = document.getElementById("start-cta");
      const browse = document.getElementById("browse-cta");
      const label = document.getElementById("start-cta-label");
      const flag = document.getElementById("start-cta-flag");

      if (start) start.setAttribute("href", target.practice);
      if (browse) browse.setAttribute("href", target.scenarios);
      if (label) label.textContent = target.label;
      if (flag) flag.textContent = target.flag;
    })();
  </script>

  <section class="marquee full-bleed" aria-hidden="true">
    <div class="marquee-track">
      {
        [...marquee, ...marquee].map((entry) =>
          entry.word === null ? (
            <span class="chip chip--flag">{entry.flag}</span>
          ) : (
            <span class="chip">{entry.word}</span>
          )
        )
      }
    </div>
  </section>

  {/* Who this is for, at the size the headline is: people who have no use
      for the textbook sentences a course opens with. */}
  <section class="for-travelers full-bleed">
    <div class="container">
      <h2 class="for-travelers-line reveal">For those who don&rsquo;t want to learn &ldquo;The house is red.&rdquo;</h2>
    </div>
  </section>

  <section class="explainer full-bleed">
    <div class="container">
      <h2 class="reveal">What's on the site</h2>
      <p class="explainer-sub reveal">
        Try Convi is a language platform you read and practice with. Spanish, Swedish
        and German were each written on their own for their own country, so
        nothing is translated across, and every line comes from native sources:
        published phrasebooks, language teachers and native podcasts, never AI.
        Read a scenario, drill it until you can say it without looking, then
        hold the conversation.
        <a class="explainer-more" href="/about">See every section →</a>
      </p>
      <div class="tier-grid reveal">
        <div class="tier-card">
          <span class="tier-badge">Read</span>
          <h3>Read the whole scenario</h3>
          <p>
            {categoryCount} categories across the three languages, all of them
            open. Taxis, bars and slang are in there, and so is asking a
            pharmacist for something for your head.
          </p>
          <ul>
            <li>The line people really say, then what they'll probably say back</li>
            <li>A warning wherever a phrase is regional or rude</li>
          </ul>
          <LangMenu path="/scenarios" label="Browse scenarios" variant="secondary" />
        </div>
        <div class="tier-card tier-card--highlight">
          <span class="tier-badge tier-badge--accent">Practice</span>
          <h3>Drill it before you fly</h3>
          <p>
            A guided path through every scenario, so the line shows up when you
            need it and not two hours later.
          </p>
          <ul>
            <li>Rounds of {ROUND_LENGTH}: situations, matching pairs, typing</li>
            <li>Every line is spoken out loud</li>
            <li>Free, and there's no account to make</li>
          </ul>
          <LangMenu path="/practice" label="Start practicing free" variant="primary" />
        </div>
        <div class="tier-card">
          <span class="tier-badge tier-badge--talk">Talk</span>
          <h3>Hold the conversation</h3>
          <p>
            A local talks, you answer in your own words, and the conversation
            goes where your answer takes it: the bar, the taxi, the front desk.
          </p>
          <ul>
            <li>Close counts: you see the line as a local would say it</li>
            <li>Missed it? Ask them to say it again</li>
            <li>Some answers take it a different way, so it is worth a replay</li>
          </ul>
          <LangMenu path="/practice#talk" label="Try Talk mode" variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="signup full-bleed" data-waitlist-own>
    <div class="container reveal">
      <h2>The app isn't out yet</h2>
      <p class="signup-sub">
        Leave your email and we'll tell you when the app and the printable
        phrasebook are ready.
      </p>
      <form class="signup-form" id="signup-form">
        <input type="email" name="email" placeholder="you@email.com" required aria-label="Email address" />
        <button type="submit">Notify me</button>
      </form>
      <p class="signup-note" id="signup-note" hidden>Thanks! We'll let you know.</p>
      <p class="signup-error" id="signup-error" hidden>Something went wrong. Try again in a moment.</p>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("signup-form") as HTMLFormElement | null;
  const note = document.getElementById("signup-note");
  const errorNote = document.getElementById("signup-error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (errorNote) errorNote.hidden = true;
    const email = (new FormData(form).get("email") as string) ?? "";

    try {
      const res = await fetch("/api/signup", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
      if (!res.ok) throw new Error("signup failed");
      form.hidden = true;
      if (note) note.hidden = false;
    } catch {
      if (errorNote) errorNote.hidden = false;
    }
  });

  // Scroll-reveal — progressive enhancement. Without JS (or with reduced
  // motion) elements stay visible; we only opt in to the animation here.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const reveals = document.querySelectorAll<HTMLElement>(".reveal");

  if (!reduce && "IntersectionObserver" in window) {
    document.documentElement.classList.add("reveal-ready");
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    reveals.forEach((el) => io.observe(el));
  }
</script>

<style>
  .hero {
    background: radial-gradient(120% 100% at 85% 0%, #ffe6d5 0%, #fff 55%);
    margin-top: -1.5rem;
    padding: clamp(2.5rem, 5.5vw, 6rem) 0 clamp(2.75rem, 5vw, 5.5rem);
    /* Clip sideways only. A plain `overflow: hidden` here also cut the language
       dropdown off at the bottom of the hero — on a wide screen the panel hangs
       about 36px past it, so "German" was sliced in half by the edge of the
       marquee. `clip` is what allows the other axis to stay visible at all:
       pairing `visible` with `hidden` silently computes to `auto` and turns the
       hero into a scroll container instead. Browsers without `overflow: clip`
       drop the declaration and lose the sideways clip, which costs nothing —
       nothing in the hero overflows horizontally at any width. */
    overflow-x: clip;
    overflow-y: visible;
  }

  /* Every vertical measure on this page is a clamp rather than a fixed rem.
     A 3.5rem band is generous on a laptop and cramped on a 27-inch monitor,
     which is what made the page feel tight at width: the columns got wider
     and the space between things did not. */

  .hero .container {
    max-width: var(--shell-wide);
  }

  /*
   * Copy left, conversation right.
   *
   * `minmax(0, …)` on both tracks because a grid column's default floor is the
   * width of its longest unbreakable word, which is what lets a long Spanish
   * line in the card push the whole row wider than the page at middling
   * widths. The gap grows with the window rather than sitting at one value:
   * 8rem was set when the right-hand column held a paper plane that could be
   * any size, and it squeezed the card to 340px once the card held sentences.
   */
  .hero-grid {
    display: grid;
    /*
     * Copy, card, and an empty track that holds the card off the right edge.
     *
     * The inset used to be `margin-right` on the card. A margin is not
     * something the grid knows about, so the card simply slid out of its own
     * column and, between about 760px and 1024px, fifteen pixels into the
     * copy's. A third track is the same inset expressed as layout: the grid
     * subtracts it before it sizes anything, so the card cannot reach the
     * copy at any width.
     */
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr) clamp(0rem, 5vw, 7rem);
    align-items: center;
    gap: clamp(1.5rem, 3.5vw, 4.5rem);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /*
     * The same inch the card is held off the right edge by, on the left.
     *
     * The copy used to start hard against the container's gutter while the
     * card sat inset from its own edge, so the band was lopsided: one side
     * breathing, the other flush.
     *
     * Offset rather than margin, and that is the whole of it. A margin is
     * layout: the grid area contains the item's margin box, so an inch on the
     * left is an inch off the measure, and "Learn how to speak like a local."
     * went from two lines to three at every width worth looking at. The copy
     * does not need to be narrower, it needs to start further in — so it keeps
     * its column and is painted an inch to the right of it. Nothing reflows.
     *
     * Where that inch comes from: the card is capped at 460px and sits at the
     * end of a column wider than that, so there is dead space to its left. The
     * offset moves the copy into that space and nowhere near the card. Below
     * about 1280px the column is no wider than the card and the space is not
     * there, which is what the lower bound of the clamp is for — it stays at
     * zero until there is room, then reaches the full inch by ~1760px.
     *
     * `inset-inline-start`, not `transform`: .hero-copy carries `reveal`,
     * which animates a transform of its own, and two of them on one element is
     * the entrance fighting itself.
     *
     * The header is untouched by any of this. It is outside .hero entirely and
     * keeps the wordmark at the window's edge, which is the arrangement
     * --shell-pad exists to hold.
     */
    position: relative;
    inset-inline-start: clamp(0rem, 12vw - 7.5rem, 6rem);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.25rem;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .tagline {
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 5.6vw, 3.85rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 0.75rem 0 1.75rem;
    /* Three or four lines at this measure, which keeps it reading as a
       headline rather than a sentence. It names the places, so it runs longer
       than "Learn how to speak like a local." did, and steps its size down. */
    max-width: 17ch;
    text-wrap: balance;
  }

  .sub {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.5;
    color: var(--color-ink-soft);
    margin: 1.75rem 0 0;
    max-width: 50ch;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }

  /* `.button` as well, to outrank the `.button { display: inline-block }`
     further down: at equal weight the later rule won, the flex never applied,
     and the flag sat against the first letter with no gap. */
  .button.start-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    /* The one thing to do on the page, so it is the biggest thing to press:
       longer and taller than anything beside it. */
    padding: 1.2rem 1.6rem 1.2rem 1.85rem;
    min-width: min(100%, 22rem);
    font-size: 1.2rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .button.start-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 5px 0 var(--color-primary-dark);
  }

  .button.start-cta:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 var(--color-primary-dark);
  }

  .start-cta-arrow {
    width: 1.1em;
    height: 1.1em;
    margin-left: auto;
    transition: transform 0.2s ease;
  }

  .button.start-cta:hover .start-cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .button.start-cta,
    .start-cta-arrow {
      transition: none;
    }
  }

  .start-cta-flag {
    font-size: 1.15em;
    line-height: 1;
  }

  .hero-alt {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
  }

  .hero-alt a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-alt a:hover {
    color: var(--color-primary-dark);
  }

  /* Ends against the right of the band, then pulled back off it.
     Flush right squared the card against the header's button but left it
     further from the copy than from anything else on the page. The inset is
     about an inch at desktop width and scales down with the window, so the
     card stays off the edge without stranding itself on a phone. */
  .hero-art {
    justify-self: end;
    width: 100%;
    max-width: 460px;
    /*
     * Room above the card for Convi, who is drawn standing behind it.
     *
     * His SVG is 320 by 272 units and the card's edge crosses it at 252, so
     * the part above the edge is 0.7875 of his width. Padding rather than
     * letting him overhang: the space is part of the column, so the grid
     * accounts for it and he cannot land on anything at any width.
     */
    --convi-w: clamp(116px, 11vw, 168px);
    position: relative;
    padding-top: calc(var(--convi-w) * 0.7875);
  }

  .hero-convi {
    position: absolute;
    top: 0;
    right: 12%;
    width: var(--convi-w);
    /* Over the card, so the hands sit on its edge rather than under it. */
    z-index: 1;
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .hero-grid {
      /* One column, so both the card's column and the inset track go with it. */
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    /* The whole point of the mobile hero: copy first.
       `order: -1` used to put the paper plane above the headline, which spent
       the top of every phone screen on decoration and pushed the button off it
       — on a 390×844 screen the first thing you could tap was below the fold.
       The art is a grid item and the lines below are flex items of .hero-copy,
       so the two sets of `order` values never interact: this one only says
       "after the copy". */
    /* Full width now, not 180px. The plane was decoration and could be shrunk
       to a thumbnail; a conversation at 180px is unreadable, which would make
       it decoration too. It still sits after the copy, so the fold is
       unaffected either way. */
    .hero-art {
      order: 1;
      max-width: 420px;
      justify-self: center;
      margin-top: 0.5rem;
    }

    .hero-grid {
      /* One column, so there is no right edge to end against. */
      justify-items: stretch;
    }

    /* One column, so there is no card to balance against either. The clamp is
       already at zero this far down; this says so out loud, so a later change
       to its lower bound cannot indent a phone by accident. */
    .hero-copy {
      inset-inline-start: 0;
    }

    /* Headline, then the button, then the pitch. The paragraph explaining what
       this is matters to somebody deciding; it does not need to come before the
       way in, and 130px of it between the two is what put the button off the
       screen. */
    .eyebrow {
      order: 1;
      margin-bottom: 0.5rem;
    }
    .tagline {
      order: 2;
      /* Three lines at phone width, at a size that leaves the button on the
         first screen. */
      font-size: clamp(2.05rem, 9vw, 2.6rem);
      max-width: 20ch;
      margin: 0 0 0.9rem;
    }
    .cta {
      order: 3;
    }
    .hero-alt {
      order: 4;
    }
    .sub {
      order: 5;
      margin: 1.25rem 0 0;
      font-size: 1.05rem;
    }
    .trust {
      order: 6;
    }
    .editions {
      order: 7;
    }

    .hero {
      /* Every rem above the fold is one the button pays for. */
      padding: 1.5rem 0 2.25rem;
    }
  }

  /* Slang marquee */
  .marquee {
    background: var(--color-primary);
    padding: clamp(0.85rem, 1.4vw, 1.25rem) 0;
    overflow: hidden;
    display: flex;
  }

  .marquee-track {
    display: flex;
    gap: 0.75rem;
    white-space: nowrap;
    width: max-content;
    animation: marquee-scroll 44s linear infinite;
  }

  .chip {
    font-weight: 600;
    font-size: 0.95rem;
    color: #fff;
    /* A darkening wash rather than a lightening one: white text on the band's
       orange alone is 3.7:1, under AA. This puts it past 4.5:1. */
    background: rgba(70, 20, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.4);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
