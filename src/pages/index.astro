---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import { getContent } from "../lib/content";

const { meta } = getContent();

const slang = [
  "¿Qué tal?",
  "una caña, porfa",
  "¡qué guay!",
  "guiri",
  "molón",
  "¿me pones...?",
  "vale, vale",
  "tío",
  "¡flipas!",
  "majo",
  "sobremesa",
  "¡nos vemos!",
];
---

<Layout>
  <section class="hero full-bleed">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow"><Logo size="sm" /> <span>· for travelers with somewhere to be</span></p>
        <h1 class="tagline">Learn how to speak like a local.</h1>
        <p class="sub">
          Skip the textbook. This is the Spanish you'll actually use — ordering
          the second round, flirting in a plaza, arguing with a taxi driver, and
          catching the slang locals fire back at you.
        </p>
        <div class="cta">
          <a class="button" href="/scenarios">Start exploring</a>
          <a class="button secondary" href="/practice">Try Practice</a>
        </div>
        <p class="language-note">🇪🇸 Spanish is live now — more languages boarding soon.</p>
      </div>

      <div class="hero-art reveal" aria-hidden="true">
        <svg viewBox="0 0 320 320" role="presentation" class="plane-svg">
          <path
            class="flight-path"
            d="M40 250 C 90 120, 210 90, 285 55"
            fill="none"
          />
          <g class="plane">
            <path
              d="M285 55 L232 78 L246 92 L241 116 L258 100 L292 108 Z"
              fill="var(--color-primary)"
            />
            <path
              d="M285 55 L246 92 L241 116 L263 96 Z"
              fill="var(--color-primary-dark)"
            />
          </g>
          <circle class="pin" cx="40" cy="250" r="7" />
        </svg>
      </div>
    </div>
  </section>

  <section class="marquee full-bleed" aria-hidden="true">
    <div class="marquee-track">
      {[...slang, ...slang].map((word) => <span class="chip">{word}</span>)}
    </div>
  </section>

  <section class="explainer full-bleed">
    <div class="container">
      <h2 class="reveal">What is Try Convi?</h2>
      <p class="explainer-sub reveal">
        A language platform built to make you conversational and speak like a
        local — the stuff you overhear on the street, not the stuff in
        Chapter 3. Browse every scenario free, then unlock practice mode to
        make it stick before you land.
      </p>
      <div class="tier-grid reveal">
        <div class="tier-card">
          <span class="tier-badge">Free</span>
          <h3>Browse every scenario</h3>
          <p>
            All 7 conversation categories — Beer &amp; Food, Slang, Flirting,
            Getting Around, and more — free to read, anytime.
          </p>
          <ul>
            <li>Real phrases people actually say</li>
            <li>"What they'll probably say back"</li>
            <li>No sign-up required</li>
          </ul>
          <a class="button secondary" href="/scenarios">Browse scenarios</a>
        </div>
        <div class="tier-card tier-card--highlight">
          <span class="tier-badge tier-badge--accent">One-time purchase</span>
          <h3>Practice mode</h3>
          <p>
            Flashcards and multiple-choice quizzes across every scenario, so
            the phrases actually stick.
          </p>
          <ul>
            <li>Flip-card review for every phrase</li>
            <li>Multiple-choice quiz mode</li>
            <li>Pay once, yours forever</li>
          </ul>
          <a class="button" href="/practice">Unlock Practice</a>
        </div>
      </div>
    </div>
  </section>

  <section class="signup full-bleed">
    <div class="container reveal">
      <h2>Get Try Convi in your pocket</h2>
      <p class="signup-sub">
        Drop your email and we'll ping you the moment the app (and printable
        phrasebook) is ready for your next trip.
      </p>
      <form class="signup-form" id="signup-form">
        <input type="email" name="email" placeholder="you@email.com" required aria-label="Email address" />
        <button type="submit">Notify me</button>
      </form>
      <p class="signup-note" id="signup-note" hidden>Thanks — we'll let you know!</p>
      <p class="signup-error" id="signup-error" hidden>Something went wrong — try again in a moment.</p>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("signup-form") as HTMLFormElement | null;
  const note = document.getElementById("signup-note");
  const errorNote = document.getElementById("signup-error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (errorNote) errorNote.hidden = true;
    const email = (new FormData(form).get("email") as string) ?? "";

    try {
      const res = await fetch("/api/signup", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
      if (!res.ok) throw new Error("signup failed");
      form.hidden = true;
      if (note) note.hidden = false;
    } catch {
      if (errorNote) errorNote.hidden = false;
    }
  });

  // Scroll-reveal — progressive enhancement. Without JS (or with reduced
  // motion) elements stay visible; we only opt in to the animation here.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const reveals = document.querySelectorAll<HTMLElement>(".reveal");

  if (!reduce && "IntersectionObserver" in window) {
    document.documentElement.classList.add("reveal-ready");
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    reveals.forEach((el) => io.observe(el));
  }
</script>

<style>
  .hero {
    background: radial-gradient(120% 100% at 85% 0%, #ffe6d5 0%, #fff 55%);
    margin-top: -1.5rem;
    padding: 3.5rem 0 3rem;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 6rem;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1rem;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .tagline {
    font-family: var(--font-heading);
    font-size: clamp(2.6rem, 7vw, 4.25rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0.5rem 0 1rem;
    max-width: 15ch;
  }

  .sub {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.5;
    color: var(--color-ink-soft);
    margin: 0 0 1.75rem;
    max-width: 46ch;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-art {
    justify-self: center;
    width: 100%;
    max-width: 340px;
  }

  .plane-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .flight-path {
    stroke: var(--color-primary);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 6 12;
    opacity: 0.6;
  }

  .pin {
    fill: var(--color-primary-dark);
  }

  .plane {
    transform-origin: center;
    animation: plane-float 4s ease-in-out infinite;
  }

  @keyframes plane-float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-8px) rotate(-2deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plane {
      animation: none;
    }
  }

  @media (max-width: 720px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .hero-art {
      order: -1;
      max-width: 220px;
      justify-self: flex-start;
    }
  }

  /* Slang marquee */
  .marquee {
    background: var(--color-primary);
    padding: 0.85rem 0;
    overflow: hidden;
    display: flex;
  }

  .marquee-track {
    display: flex;
    gap: 0.75rem;
    white-space: nowrap;
    width: max-content;
    animation: marquee-scroll 32s linear infinite;
  }

  .chip {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: #fff;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      white-space: normal;
    }
  }

  /* Scroll reveal — only active once JS opts in via .reveal-ready */
  :global(.reveal-ready) .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  :global(.reveal-ready) .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  .button {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-heading);
    box-shadow: 0 4px 0 var(--color-primary-dark);
  }

  .button.secondary {
    background: transparent;
    color: var(--color-ink);
    border: 2px solid var(--color-ink);
    box-shadow: none;
  }

  @media (max-width: 480px) {
    .cta {
      flex-direction: column;
    }

    .button {
      text-align: center;
    }
  }

  .language-note {
    margin: 1.25rem 0 0;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  :global(main) {
    padding-bottom: 0;
  }

  .explainer {
    background: #fff;
    border-top: 1px solid var(--color-border);
    padding: 4rem 0;
  }

  .explainer .container {
    max-width: 960px;
  }

  .explainer h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 0.75rem;
  }

  .explainer-sub {
    color: var(--color-ink-soft);
    font-size: 1.05rem;
    max-width: 56ch;
    margin: 0 0 2.5rem;
  }

  .tier-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .tier-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .tier-card--highlight {
    border-color: var(--color-primary);
    box-shadow: 0 4px 0 var(--color-primary-dark);
  }

  .tier-badge {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-soft);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    margin: 0 0 1rem;
  }

  .tier-badge--accent {
    color: var(--color-primary-dark);
    background: #ffe6d5;
    border-color: transparent;
  }

  .tier-card h3 {
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
  }

  .tier-card > p {
    color: var(--color-ink-soft);
    margin: 0 0 1rem;
  }

  .tier-card ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tier-card li {
    padding-left: 1.4rem;
    position: relative;
    font-size: 0.95rem;
  }

  .tier-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  .tier-card .button {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (max-width: 720px) {
    .tier-grid {
      grid-template-columns: 1fr;
    }
  }

  .signup {
    background: #ffe6d5;
    padding: 3.5rem 0;
  }

  .signup .container {
    max-width: 560px;
  }

  .signup h2 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }

  .signup-sub {
    color: var(--color-ink-soft);
    margin: 0 0 1.25rem;
  }

  .signup-form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .signup-form input {
    flex: 1;
    min-width: 200px;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: 1rem;
    font-family: var(--font-body);
  }

  .signup-form input:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .signup-form button {
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    border: none;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    font-family: var(--font-heading);
    cursor: pointer;
    box-shadow: 0 4px 0 var(--color-primary-dark);
  }

  .signup-note {
    font-weight: 600;
    color: var(--color-primary-dark);
  }

  .signup-error {
    font-weight: 600;
    color: var(--color-error);
  }
</style>
