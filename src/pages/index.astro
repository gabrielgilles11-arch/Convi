---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import LangMenu from "../components/LangMenu.astro";
import HeroDemo from "../components/HeroDemo.astro";
import {
  LOCALES,
  countCategoryItems,
  getCategories,
  localePath,
  roughLineCount,
  DEFAULT_LOCALE,
} from "../lib/content";
import { LAST_LOCALE_KEY } from "../lib/lastLocale";

// Counts come from the content files so this copy can never drift out of date
// as categories are added to any edition.
const editions = LOCALES.map((l) => {
  const categories = getCategories(l.locale);
  return { ...l, total: categories.length };
});

const categoryCount = editions.reduce((n, e) => n + e.total, 0);

// One marquee band per edition, each led by its flag, so the strip itself shows
// which three languages the site covers. Flags come from LOCALES.
const MARQUEE_WORDS: Record<string, string[]> = {
  "es-ES": ["¿Qué tal?", "una caña, porfa", "¡qué guay!", "guiri", "¿me pones...?", "vale, vale", "tío", "¡flipas!", "sobremesa", "mola mazo", "en plan...", "resacón"],
  "sv-SE": ["asså", "typ", "Nu kör vi", "taggad", "sjukt", "fett", "skitbra", "vi tar tuben", "bärs", "ta en AW"],
  "de-DE": ["krass", "geil", "mega", "stabil", "läuft gut", "kein Bock", "Alter!", "Servus!", "Passt scho.", "Mei…"],
};

const marquee = editions.flatMap((e) => [
  { flag: e.flag, word: null },
  ...(MARQUEE_WORDS[e.locale] ?? []).map((word) => ({ flag: null, word })),
]);

/**
 * Where the hero's one button goes, per edition.
 *
 * Built here rather than in the browser so the script below never has to know
 * a slug table, and so a stored slug can be checked against real editions
 * before it is allowed anywhere near an href. Keyed by slug because that is
 * what the browser remembers.
 */
const startTargets = Object.fromEntries(
  LOCALES.map((l) => [
    l.slug,
    {
      practice: localePath(l.locale, "/practice"),
      scenarios: localePath(l.locale, "/scenarios"),
      label: `Start practicing ${l.language}`,
      flag: l.flag,
    },
  ])
);

// What the page ships with, for everyone arriving for the first time and for
// anyone with JavaScript off: the default edition, already a working link.
const defaultStart = startTargets[LOCALES.find((l) => l.locale === DEFAULT_LOCALE)!.slug];

/**
 * The home page's own title and description.
 *
 * It had neither, so it inherited the layout's fallback and went to search as
 * "Try Convi" — which names a site nobody has heard of and says nothing about
 * what is on it. Every other page on the site carries a search-intent title
 * built from its content; this one, the most linked page there is, was the
 * exception.
 *
 * The counts come from the content files for the same reason the copy below
 * does: a number typed into a meta tag is a number that goes stale silently.
 */
const lineCount = editions.reduce(
  (n, e) => n + getCategories(e.locale).reduce((m, c) => m + countCategoryItems(c), 0),
  0
);

/**
 * The same number, said the way a person says it.
 *
 * Still read from the content files, so it cannot drift; just not read out to
 * the digit. See `roughLineCount`.
 */
const roughLines = roughLineCount(lineCount);

const pageTitle = "Try Convi: real Spanish, Swedish and German phrases for travelers";
const pageDescription = `The Spanish, Swedish and German people actually speak, from ordering and taxis to slang and nightlife, with what they'll say back. ${categoryCount} free scenario packs and ${roughLines} lines. No account, no paywall.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="hero full-bleed">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow"><Logo size="sm" /> <span>· for travelers with somewhere to be</span></p>
        <h1 class="tagline">Learn how to speak like a local.</h1>
        <div class="cta">
          {/* One tap into the language you were last reading — no menu, no
              second decision. The href and the label ship as the default
              edition and are rewritten below if this browser has a choice
              already. Picking a different language is still here, one step to
              the side, which is where a thing you do once belongs. */}
          <a class="button start-cta" id="start-cta" href={defaultStart.practice}>
            <span class="start-cta-flag" aria-hidden="true" id="start-cta-flag">{defaultStart.flag}</span>
            <span id="start-cta-label">{defaultStart.label}</span>
          </a>
          <LangMenu path="/practice" label="Another language" variant="secondary" />
        </div>
        <p class="hero-alt">
          <a id="browse-cta" href={defaultStart.scenarios}>or read the scenarios first →</a>
        </p>
        <p class="sub">
          Skip the textbook. This is the Spanish, Swedish and German you'll
          actually use: ordering the second round, flirting at the bar, arguing
          with a taxi driver, and catching the slang locals fire back at you.
        </p>
        <p class="language-note">
          <strong>Three editions live now.</strong> Pick your language above.
          {
            editions.map((e, i) => (
              <>
                {i > 0 && <span class="dot" aria-hidden="true"> · </span>}
                <span class="edition">
                  <span class="edition-flag" aria-hidden="true">{e.flag}</span>
                  <span>{e.language}</span>
                  <span class="edition-region">({e.region})</span>
                </span>
              </>
            ))
          }
        </p>
      </div>

      {/* No `reveal` on this one. The card runs its own entrance, and two
          fade-ins on the same element is the jank the demo was built to avoid. */}
      <div class="hero-art">
        <HeroDemo />
      </div>
    </div>
  </section>

  {/* Inline and right here on purpose: the button is a few lines above, and a
      bundled module script would run after first paint, so the label would be
      seen saying "Spanish" before it corrected itself. */}
  <script is:inline define:vars={{ startTargets, LAST_LOCALE_KEY }}>
    (() => {
      let slug;
      try {
        slug = window.localStorage.getItem(LAST_LOCALE_KEY);
      } catch {
        return; // Private mode. The default edition is already in the href.
      }
      // A stored value is a value from outside, and this one ends up in an
      // href. Only a slug that names a real edition gets used; anything else
      // leaves the default in place.
      if (slug === null || !Object.prototype.hasOwnProperty.call(startTargets, slug)) return;

      const target = startTargets[slug];
      const start = document.getElementById("start-cta");
      const browse = document.getElementById("browse-cta");
      const label = document.getElementById("start-cta-label");
      const flag = document.getElementById("start-cta-flag");

      if (start) start.setAttribute("href", target.practice);
      if (browse) browse.setAttribute("href", target.scenarios);
      if (label) label.textContent = target.label;
      if (flag) flag.textContent = target.flag;
    })();
  </script>

  <section class="marquee full-bleed" aria-hidden="true">
    <div class="marquee-track">
      {
        [...marquee, ...marquee].map((entry) =>
          entry.word === null ? (
            <span class="chip chip--flag">{entry.flag}</span>
          ) : (
            <span class="chip">{entry.word}</span>
          )
        )
      }
    </div>
  </section>

  {/* Who this is for, at the size the headline is.

      The headline stays what it was, because "Learn how to speak like a local"
      is the promise and it is the founder's line. What it does not say is who
      is making the trip, and the only place the site said that was six words
      of gray text in the eyebrow above it. A traveler reading this page had
      to infer that it was written for them. This says it. */}
  <section class="for-travelers full-bleed">
    <div class="container">
      <p class="for-travelers-kicker reveal">Who it's for</p>
      <h2 class="for-travelers-line reveal">Built for travelers, not for classrooms.</h2>
      <p class="for-travelers-sub reveal">
        You have a week, not a semester. This is what you'll actually use on
        the trip: {roughLines} lines, written for the country you're going to,
        each one with what they'll say back to you.
      </p>
    </div>
  </section>

  <section class="explainer full-bleed">
    <div class="container">
      <h2 class="reveal">What is Try Convi?</h2>
      <p class="explainer-sub reveal">
        A language platform built to make you conversational and speak like a
        local: the stuff you overhear on the street, not the stuff in
        Chapter 3. Three independent editions, in Spanish, Swedish and German.
        Read every scenario, then drill them in practice mode until they stick,
        all of it free, no account needed.
        <a class="explainer-more" href="/about">What this is, and every section →</a>
      </p>
      <div class="tier-grid reveal">
        <div class="tier-card">
          <span class="tier-badge">Read</span>
          <h3>Every scenario, start to finish</h3>
          <p>
            {categoryCount} everyday conversation categories across all three
            languages: getting around, slang, ordering a beer, flirting,
            emergencies, the lot. Nothing held back.
          </p>
          <ul>
            <li>Real phrases people actually say</li>
            <li>"What they'll probably say back"</li>
            <li>Spanish, Swedish and German editions</li>
            <li>No sign-up required</li>
          </ul>
          <LangMenu path="/scenarios" label="Browse scenarios" variant="secondary" />
        </div>
        <div class="tier-card tier-card--highlight">
          <span class="tier-badge tier-badge--accent">Practice</span>
          <h3>Make it stick before you land</h3>
          <p>
            A guided path through every scenario in every language, so the line
            you need arrives when you need it instead of two hours later.
          </p>
          <ul>
            <li>A guided path through every scenario</li>
            <li>Rounds of eight: situations, matching pairs, typing</li>
            <li>Hear every line spoken out loud</li>
            <li>Spanish, Swedish <em>and</em> German</li>
            <li>Free, no account, no card</li>
          </ul>
          <LangMenu path="/practice" label="Start practicing" variant="primary" />
        </div>
      </div>
    </div>
  </section>

  <section class="signup full-bleed">
    <div class="container reveal">
      <h2>Get Try Convi in your pocket</h2>
      <p class="signup-sub">
        Drop your email and we'll ping you the moment the app (and printable
        phrasebook) is ready for your next trip.
      </p>
      <form class="signup-form" id="signup-form">
        <input type="email" name="email" placeholder="you@email.com" required aria-label="Email address" />
        <button type="submit">Notify me</button>
      </form>
      <p class="signup-note" id="signup-note" hidden>Thanks! We'll let you know.</p>
      <p class="signup-error" id="signup-error" hidden>Something went wrong. Try again in a moment.</p>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("signup-form") as HTMLFormElement | null;
  const note = document.getElementById("signup-note");
  const errorNote = document.getElementById("signup-error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (errorNote) errorNote.hidden = true;
    const email = (new FormData(form).get("email") as string) ?? "";

    try {
      const res = await fetch("/api/signup", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
      if (!res.ok) throw new Error("signup failed");
      form.hidden = true;
      if (note) note.hidden = false;
    } catch {
      if (errorNote) errorNote.hidden = false;
    }
  });

  // Scroll-reveal — progressive enhancement. Without JS (or with reduced
  // motion) elements stay visible; we only opt in to the animation here.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const reveals = document.querySelectorAll<HTMLElement>(".reveal");

  if (!reduce && "IntersectionObserver" in window) {
    document.documentElement.classList.add("reveal-ready");
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    reveals.forEach((el) => io.observe(el));
  }
</script>

<style>
  .hero {
    background: radial-gradient(120% 100% at 85% 0%, #ffe6d5 0%, #fff 55%);
    margin-top: -1.5rem;
    padding: clamp(2.5rem, 5.5vw, 6rem) 0 clamp(2.75rem, 5vw, 5.5rem);
    /* Clip sideways only. A plain `overflow: hidden` here also cut the language
       dropdown off at the bottom of the hero — on a wide screen the panel hangs
       about 36px past it, so "German" was sliced in half by the edge of the
       marquee. `clip` is what allows the other axis to stay visible at all:
       pairing `visible` with `hidden` silently computes to `auto` and turns the
       hero into a scroll container instead. Browsers without `overflow: clip`
       drop the declaration and lose the sideways clip, which costs nothing —
       nothing in the hero overflows horizontally at any width. */
    overflow-x: clip;
    overflow-y: visible;
  }

  /* Every vertical measure on this page is a clamp rather than a fixed rem.
     A 3.5rem band is generous on a laptop and cramped on a 27-inch monitor,
     which is what made the page feel tight at width: the columns got wider
     and the space between things did not. */

  .hero .container {
    max-width: var(--shell-wide);
  }

  /*
   * Copy left, conversation right.
   *
   * `minmax(0, …)` on both tracks because a grid column's default floor is the
   * width of its longest unbreakable word, which is what lets a long Spanish
   * line in the card push the whole row wider than the page at middling
   * widths. The gap grows with the window rather than sitting at one value:
   * 8rem was set when the right-hand column held a paper plane that could be
   * any size, and it squeezed the card to 340px once the card held sentences.
   */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 6.5rem);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.25rem;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .tagline {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 4.25rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0.75rem 0 1.75rem;
    /* Three lines at this measure, which is the shape the headline was drawn
       at. Left to the full column it goes to two long ones and stops reading
       as a headline. */
    max-width: 14ch;
  }

  .sub {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.5;
    color: var(--color-ink-soft);
    margin: 1.75rem 0 0;
    max-width: 50ch;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .start-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .start-cta-flag {
    font-size: 1.15em;
    line-height: 1;
  }

  .hero-alt {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
  }

  .hero-alt a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-alt a:hover {
    color: var(--color-primary-dark);
  }

  /* Ends against the right of the band, then pulled back off it.
     Flush right squared the card against the header's button but left it
     further from the copy than from anything else on the page. The inset is
     about an inch at desktop width and scales down with the window, so the
     card stays off the edge without stranding itself on a phone. */
  .hero-art {
    justify-self: end;
    width: 100%;
    max-width: 460px;
    margin-right: clamp(0rem, 4.8vw, 6rem);
  }

  @media (max-width: 720px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    /* The whole point of the mobile hero: copy first.
       `order: -1` used to put the paper plane above the headline, which spent
       the top of every phone screen on decoration and pushed the button off it
       — on a 390×844 screen the first thing you could tap was below the fold.
       The art is a grid item and the lines below are flex items of .hero-copy,
       so the two sets of `order` values never interact: this one only says
       "after the copy". */
    /* Full width now, not 180px. The plane was decoration and could be shrunk
       to a thumbnail; a conversation at 180px is unreadable, which would make
       it decoration too. It still sits after the copy, so the fold is
       unaffected either way. */
    .hero-art {
      order: 1;
      max-width: 420px;
      justify-self: center;
      /* One column: there is no right edge to sit off. */
      margin-right: 0;
      margin-top: 0.5rem;
    }

    .hero-grid {
      /* One column, so there is no right edge to end against. */
      justify-items: stretch;
    }

    /* Headline, then the button, then the pitch. The paragraph explaining what
       this is matters to somebody deciding; it does not need to come before the
       way in, and 130px of it between the two is what put the button off the
       screen. */
    .eyebrow {
      order: 1;
      margin-bottom: 0.5rem;
    }
    .tagline {
      order: 2;
      /* 15ch broke "Learn how to speak like a local." over three lines at phone
         width. Two lines is 42px back. */
      font-size: clamp(2.05rem, 9vw, 2.6rem);
      max-width: 20ch;
      margin: 0 0 0.9rem;
    }
    .cta {
      order: 3;
    }
    .hero-alt {
      order: 4;
    }
    .sub {
      order: 5;
      margin: 1.25rem 0 0;
      font-size: 1.05rem;
    }
    .language-note {
      order: 6;
    }

    .hero {
      /* Every rem above the fold is one the button pays for. */
      padding: 1.5rem 0 2.25rem;
    }
  }

  /* Slang marquee */
  .marquee {
    background: var(--color-primary);
    padding: clamp(0.85rem, 1.4vw, 1.25rem) 0;
    overflow: hidden;
    display: flex;
  }

  .marquee-track {
    display: flex;
    gap: 0.75rem;
    white-space: nowrap;
    width: max-content;
    animation: marquee-scroll 44s linear infinite;
  }

  .chip {
    font-weight: 600;
    font-size: 0.95rem;
    color: #fff;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      white-space: normal;
    }
  }

  /* Scroll reveal — only active once JS opts in via .reveal-ready */
  :global(.reveal-ready) .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  :global(.reveal-ready) .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  .button {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    letter-spacing: 0.04em;
    box-shadow: 0 4px 0 var(--color-primary-dark);
  }

  .button.secondary {
    background: transparent;
    color: var(--color-ink);
    border: 2px solid var(--color-ink);
    box-shadow: none;
  }

  @media (max-width: 480px) {
    .cta {
      flex-direction: column;
      align-items: stretch;
    }

    .button {
      text-align: center;
    }

    .start-cta {
      justify-content: center;
    }
  }

  .language-note {
    margin: 2.25rem 0 0;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    max-width: 46ch;
    line-height: 1.7;
  }

  .language-note strong {
    color: var(--color-ink);
  }

  .edition {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    white-space: nowrap;
  }

  .edition-region {
    opacity: 0.75;
  }

  .chip--flag {
    background: #fff;
    border-color: #fff;
    font-size: 1.05rem;
    padding: 0.35rem 0.7rem;
  }

  /* The tier-card buttons are LangMenu dropdowns, which bring their own
     styling; they just need the same bottom alignment the links had. */
  .tier-card :global(.lang-menu) {
    margin-top: auto;
    align-self: flex-start;
  }

  :global(main) {
    padding-bottom: 0;
  }

  /* Who it's for, said at headline size.

     Display type and a full-bleed tint, so it reads as a statement rather than
     another paragraph of body copy. Sized just under .tagline: it is the
     second-largest thing on the page, which is what "somewhere else in big
     letters" means when the headline keeps the top spot. */
  .for-travelers {
    background: var(--color-primary-tint);
    border-top: 1px solid var(--color-primary-tint-border);
    border-bottom: 1px solid var(--color-primary-tint-border);
    padding: clamp(3rem, 6vw, 6rem) 0;
  }

  /* Centered, at the band's full width.
     Ranged left, the headline stopped a third of the way across a 1,600px band
     and the rest of it read as a mistake rather than as space. This is the one
     band on the page whose whole job is to say one thing, so it says it in the
     middle. */
  .for-travelers .container {
    max-width: var(--shell-wide);
    text-align: center;
  }

  .for-travelers-kicker {
    margin: 0 0 0.9rem;
    /* Uppercase and tracked, which is the one case the 13px floor gives way. */
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary-dark);
  }

  .for-travelers-line {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    /* `auto` sides so the measure itself centers. 22ch rather than 18ch:
       centered text wants a wider measure before it starts looking like a
       column, and the line still breaks in two. */
    margin: 0 auto 1.5rem;
    max-width: 22ch;
    color: var(--color-ink);
  }

  .for-travelers-sub {
    margin: 0 auto;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 52ch;
  }

  @media (max-width: 720px) {
    .for-travelers {
      padding: 2.5rem 0;
    }

    .for-travelers-line {
      max-width: 14ch;
    }
  }

  .explainer {
    background: #fff;
    border-top: 1px solid var(--color-border);
    padding: clamp(3.5rem, 6.5vw, 7rem) 0;
  }

  .explainer .container {
    max-width: var(--shell-wide);
    text-align: center;
  }

  .explainer h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 1rem;
  }

  .explainer-sub {
    color: var(--color-ink-soft);
    font-size: 1.05rem;
    max-width: 56ch;
    margin: 0 auto clamp(2.5rem, 4.5vw, 4rem);
  }


  .explainer-more {
    min-height: 44px;
    display: block;
    text-align: center;
    margin-top: 0.75rem;
    color: var(--color-primary-dark);
    font-weight: 700;
    text-decoration: none;
  }

  .explainer-more:hover {
