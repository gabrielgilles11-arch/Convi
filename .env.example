# Every environment variable this project reads, with no values.
#
# Copy to .env for local development. .env is gitignored and must stay that
# way: nothing in this file should ever gain a value in version control.
#
# In production these live in the Vercel project settings, not in a file.

# --- Storage -----------------------------------------------------------------
# Upstash Redis. Optional: without it, rate limiting and the usage counters
# both fail open rather than failing the request.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Usage counters ----------------------------------------------------------
# Password for the /stats dashboard. Unset means the page does not exist —
# an unset secret must never be the same thing as an open door.
STATS_TOKEN=
# Salt for hashing visitor IPs. Optional: one is generated and kept in Redis on
# first use. Never a fixed public string — an unsalted IP hash is reversible.
STATS_SALT=

# --- Email -------------------------------------------------------------------
# Resend API key and the address signup notifications are sent to.
ResendAPI=
Email=

# Who mail comes from, e.g. "Try Convi <hello@tryconvi.com>". Optional, and the
# single most load-bearing line in this file if you want mail to be read.
#
# Unset, everything sends from onboarding@resend.dev — Resend's shared sandbox
# sender, which works with no DNS setup and authenticates as Resend rather than
# as this site. That is why signup notifications landed in Promotions or Spam.
# Set this to an address on a domain verified in Resend (SPF, DKIM and DMARC all
# passing) and they arrive in the inbox instead.
#
# Nothing here, and no header anywhere, can put a message at the top of a Gmail
# inbox — there is no such API. What the code does do is make one filter enough
# forever: every notification has the subject "Try Convi signup: <address>",
# carries X-Priority/Importance, and sets Reply-To to the person who signed up.
# The last mile is a filter you make once, in Gmail:
#
#   matches:  from:(<EMAIL_FROM address>) subject:("Try Convi signup")
#   do this:  Never send it to Spam · Always mark it as important · Star it
#             · Categorise as Primary
EMAIL_FROM=

# --- Reminders (web push + email nudges) -------------------------------------
# VAPID key pair for web push. Optional: without it the opt-in card offers email
# only and /api/reminders/config says push is unavailable — a half-configured
# push setup must never look available and then silently do nothing.
#
# Generate once, then keep the private half secret:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# Rotating them invalidates every existing subscription, so subscribers have to
# opt in again. The public half is served to browsers by design; it is the key
# they sign a subscription against.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address a push service can complain to. Must be a mailto: or https:
# URL — Firefox rejects a subscription signed without one. Defaults to
# mailto:hello@tryconvi.com.
VAPID_SUBJECT=

# Bearer token Vercel Cron sends to /api/reminders/run. Unset means the route is
# a 404, the same rule /stats follows: an unset secret must never be the same
# thing as an open door. This is the one endpoint here that can send mail, so it
# is also the one that must not be guessable. Set it in the Vercel project
# settings and Vercel attaches it to the scheduled request itself.
CRON_SECRET=
#
# Reminders also need Redis (KV_REST_API_* above). Without it nothing can be
# stored, so the opt-in card is never shown at all rather than accepting an
# address it would have to throw away.

# --- Payments (dormant; the paywall is currently off) ------------------------
# Signs the entitlement cookie. Required before re-enabling the paywall.
UNLOCK_SIGNING_SECRET=
# Shared secret in the Gumroad ping URL's ?secret= parameter.
GUMROAD_WEBHOOK_SECRET=
# Gumroad seller id, which the webhook checks the ping against. A public
# identifier rather than a credential, but it names an account, so it is
# configured rather than committed.
GUMROAD_SELLER_ID=

# --- Audio generation (scripts/generate-audio.mjs, run by hand) --------------
GOOGLE_TTS_API_KEY=
GOOGLE_VOICE_ES=
GOOGLE_VOICE_DE=
GOOGLE_VOICE_SV=
# Optional. Switches the Google voices to a promptable model (Gemini-TTS) so
# GOOGLE_TTS_STYLE can direct the delivery. Chirp 3: HD ignores both.
GOOGLE_TTS_MODEL=
GOOGLE_TTS_STYLE=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_VOICE_SV=
PIPER_ES_MODEL=
PIPER_SV_MODEL=
PIPER_DE_MODEL=
PIPER_VOICE_DIR=
